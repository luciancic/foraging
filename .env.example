# Storj S3 credentials for backups (scripts/backup-storj.sh).
# On this VPS these are already present in ~/myclaw/.env — the backup script
# falls back to sourcing that file, so you normally don't need this one.
STORJ_ACCESS_KEY_ID=
STORJ_SECRET_ACCESS_KEY=
STORJ_ENDPOINT=https://gateway.storjshare.io
STORJ_BUCKET=foraging
