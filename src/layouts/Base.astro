---
import '../styles/global.css';
interface Props { title: string; description?: string; page?: string; fullBleed?: boolean; }
const { title, description = 'A personal foraging map and plant field guide for Montréal.', page, fullBleed = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2f5d3a" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8D%83%3C/text%3E%3C/svg%3E" />
  </head>
  <body class={fullBleed ? 'app fullbleed' : 'app'}>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><span class="leaf">🍃</span> Forage MTL</a>
        <nav class="nav">
          <a href="/" aria-current={page === 'map' ? 'page' : undefined}>Map</a>
          <a href="/plants" aria-current={page === 'plants' ? 'page' : undefined}>Plants</a>
          <a href="/about" aria-current={page === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    {!fullBleed && (
    <footer class="site-footer">
      <div class="wrap">
        <p>A personal foraging notebook for the island of Montréal · <a href="/map">map</a> · <a href="/plants">plants</a> · <a href="/about">about</a></p>
        <p><strong>Forage responsibly:</strong> never eat anything you can't identify with certainty against a live plant and two independent sources. Learn the poisonous lookalike before the edible. When in doubt, throw it out.</p>
      </div>
    </footer>
    )}

    <div id="lightbox" class="lightbox" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Photo viewer">
      <button type="button" class="lightbox-close" aria-label="Close">✕</button>
      <img class="lightbox-img" src="" alt="" />
    </div>
    <script is:inline>
      (() => {
        const lb = document.getElementById('lightbox');
        if (!lb) return;
        const img = lb.querySelector('.lightbox-img');
        const closeBtn = lb.querySelector('.lightbox-close');
        // Any anchor whose href points at one of our photo paths.
        const isPhotoLink = (a) => /\/(images\/plants|photos\/spots)\//.test(a.getAttribute('href') || '');
        const open = (src, alt) => {
          img.src = src;
          img.alt = alt || '';
          lb.hidden = false;
          lb.setAttribute('aria-hidden', 'false');
          document.body.classList.add('lightbox-open');
        };
        const close = () => {
          lb.hidden = true;
          lb.setAttribute('aria-hidden', 'true');
          img.src = '';
          document.body.classList.remove('lightbox-open');
        };
        // Delegated: works for build-time galleries AND Leaflet popups injected later.
        document.addEventListener('click', (e) => {
          const a = e.target.closest && e.target.closest('a');
          if (!a || !isPhotoLink(a)) return;
          e.preventDefault();
          const thumb = a.querySelector('img');
          open(a.getAttribute('href'), thumb ? thumb.alt : '');
        });
        closeBtn.addEventListener('click', close);
        lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lb.hidden) close(); });
      })();
    </script>
  </body>
</html>
