---
import '../styles/global.css';
interface Props { title: string; description?: string; page?: string; fullBleed?: boolean; }
const { title, description = 'A personal foraging map and plant field guide for Montréal.', page, fullBleed = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2f5d3a" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8D%83%3C/text%3E%3C/svg%3E" />
  </head>
  <body class={fullBleed ? 'app fullbleed' : 'app'}>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><span class="leaf">🍃</span> Forage MTL</a>
        <nav class="nav">
          <a href="/" aria-current={page === 'home' ? 'page' : undefined}>Home</a>
          <a href="/map" aria-current={page === 'map' ? 'page' : undefined}>Map</a>
          <a href="/plants" aria-current={page === 'plants' ? 'page' : undefined}>Plants</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    {!fullBleed && (
    <footer class="site-footer">
      <div class="wrap">
        <p>A personal foraging notebook for the island of Montréal · <a href="/map">map</a> · <a href="/plants">plants</a></p>
        <p><strong>Forage responsibly:</strong> never eat anything you can't identify with certainty against a live plant and two independent sources. Learn the poisonous lookalike before the edible. When in doubt, throw it out.</p>
      </div>
    </footer>
    )}
    {fullBleed && (
      <script is:inline>
        // Pin the full-bleed app height to the real visible viewport. iOS Safari
        // can resolve 100dvh a touch short, leaving a gap below the map.
        (function () {
          var set = function () {
            document.documentElement.style.setProperty('--app-h', window.innerHeight + 'px');
          };
          set();
          window.addEventListener('resize', set);
          window.addEventListener('orientationchange', set);
          if (window.visualViewport) window.visualViewport.addEventListener('resize', set);
        })();
      </script>
    )}
  </body>
</html>
