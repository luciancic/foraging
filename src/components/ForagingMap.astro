---
// Client-side Leaflet map. Pins load live from the /api/pins data API (the SQLite
// DB is the source of truth), falling back to the build-time static export at
// /data/foraging-spots.geojson if the API is unreachable.
// `fullscreen` makes the map fill the viewport below the header (map page);
// otherwise it's a boxed embed (home page).
interface Props { fullscreen?: boolean; }
const { fullscreen = false } = Astro.props;
---
<div class={`map-wrap${fullscreen ? ' full' : ''}`}>
  <div class="map-shell"><div id="map"></div></div>
  <div class="map-filter" id="map-filter" hidden></div>
  <div class="legend" id="legend"></div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<script>
  import L from 'leaflet';

  const CAT_COLORS: Record<string, string> = {
    tree: '#6b8e23', berries: '#8a2f4a', greens: '#2f7d4f', herbs: '#4a8f7b',
    nuts: '#8a6d3b', mushrooms: '#9c6b4a', other: '#7a7a7a',
  };

  // Scouting layer (unverified iNaturalist leads) — a separate class from the
  // verified teardrop pins. Rendered as tier-coloured circles so the two never
  // read as the same thing. Tier = how to approach a find.
  const TIER_COLORS: Record<string, string> = {
    snack: '#2f7d4f', prep: '#b8791f', caution: '#c2571f', avoid: '#9a2b1e',
  };
  const TIER_LABEL: Record<string, string> = {
    snack: 'Snackable', prep: 'Needs prep', caution: 'Caution — lookalike', avoid: 'Toxic — avoid',
  };
  const TIER_ORDER = ['snack', 'prep', 'caution', 'avoid'];

  // Popups are built as HTML strings, so any text that originates from the DB
  // (pin fields) or third parties (iNaturalist usernames on scouting pins) must be
  // escaped before interpolation. `seg` makes a value safe inside an href/src path.
  const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]);
  const seg = (s: any) => encodeURIComponent(String(s ?? ''));

  function pinIcon(color: string) {
    const svg =
      `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="40" viewBox="0 0 28 40">` +
      `<path d="M14 0C6.3 0 0 6.2 0 13.9 0 24 14 40 14 40s14-16 14-26.1C28 6.2 21.7 0 14 0z" fill="${color}"/>` +
      `<circle cx="14" cy="14" r="5.4" fill="#fff"/></svg>`;
    return L.divIcon({
      className: 'forage-pin',
      html: svg,
      iconSize: [28, 40],
      iconAnchor: [14, 40],
      popupAnchor: [0, -38],
    });
  }

  function scoutIcon(color: string) {
    const svg =
      `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20">` +
      `<circle cx="10" cy="10" r="7" fill="${color}" fill-opacity="0.85" stroke="#fff" stroke-width="2.5"/></svg>`;
    return L.divIcon({
      className: 'scout-pin',
      html: svg,
      iconSize: [20, 20],
      iconAnchor: [10, 10],
      popupAnchor: [0, -10],
    });
  }

  const mapEl = document.getElementById('map');
  const isTouch = window.matchMedia('(pointer: coarse)').matches;

  const map = L.map('map', {
    scrollWheelZoom: false,   // desktop: unlock on click so page-scroll isn't hijacked
    tap: true,
  }).setView([45.462, -73.565], 13);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; OpenStreetMap contributors',
  }).addTo(map);
  map.on('click', () => map.scrollWheelZoom.enable());

  // ── User location ─────────────────────────────────────────────────────────
  // A "you are here" dot + accuracy halo. On the first fix we recenter the map
  // on the user (so they land in their area instead of the Montréal overview) —
  // unless they're far (>150 km) from the logged spots, where we keep the
  // overview. The locate button forces a fresh fix and surfaces a message when
  // the browser blocks/‌can't provide location (so it's never a silent no-op).
  let userMarker: any = null, accCircle: any = null;
  let didLocate = false, spotsBounds: any = null;
  const isFullMap = document.querySelector('.map-wrap')?.classList.contains('full');

  const userIcon = L.divIcon({
    className: 'user-loc',
    html: `<div class="user-dot"></div>`,
    iconSize: [24, 24],
    iconAnchor: [12, 12],
  });

  // A transient status line over the map (denied / unavailable / locating…).
  let msgTimer: any = null;
  function flash(text: string, sticky = false) {
    let el = document.getElementById('map-msg');
    if (!el) {
      el = document.createElement('div');
      el.id = 'map-msg';
      el.className = 'map-msg';
      (mapEl?.parentElement || mapEl)?.appendChild(el);
    }
    el.textContent = text;
    el.hidden = false;
    clearTimeout(msgTimer);
    if (!sticky) msgTimer = setTimeout(() => { if (el) el.hidden = true; }, 4000);
  }
  function clearFlash() {
    const el = document.getElementById('map-msg');
    if (el) el.hidden = true;
    clearTimeout(msgTimer);
  }

  function updatePosition(lat: number, lon: number, acc: number) {
    const ll = L.latLng(lat, lon);
    if (!userMarker) {
      userMarker = L.marker(ll, { icon: userIcon, interactive: false, keyboard: false, zIndexOffset: 1000 }).addTo(map);
      accCircle = L.circle(ll, {
        radius: acc || 0, interactive: false,
        color: '#1a73e8', weight: 1, opacity: 0.25, fillColor: '#1a73e8', fillOpacity: 0.12,
      }).addTo(map);
    } else {
      userMarker.setLatLng(ll);
      accCircle.setLatLng(ll).setRadius(acc || 0);
    }
  }

  function firstFix(ll: any) {
    if (didLocate) return;
    didLocate = true;
    // Center on the user unless they're far (>150 km) from the logged spots.
    const near = !spotsBounds || map.distance(ll, spotsBounds.getCenter()) < 150000;
    if (near) map.setView(ll, Math.max(map.getZoom(), 15), { animate: true });
  }

  function onFix(pos: any, recenter: boolean) {
    clearFlash();
    const { latitude, longitude, accuracy } = pos.coords;
    updatePosition(latitude, longitude, accuracy);
    if (recenter) map.setView([latitude, longitude], Math.max(map.getZoom(), 16), { animate: true });
    else firstFix(L.latLng(latitude, longitude));
  }

  function onError(err: any, loud: boolean) {
    if (!loud) return; // the silent passive watch shouldn't nag on load
    if (err && err.code === 1) flash('Location is blocked. Enable it for this site in your browser settings.', true);
    else flash('Couldn’t get your location — try again outdoors with a clear sky.');
  }

  let locating = false;
  function startLocating() {
    if (locating || !('geolocation' in navigator)) return;
    locating = true;
    navigator.geolocation.watchPosition(
      (pos) => onFix(pos, false),
      (err) => onError(err, false),
      { enableHighAccuracy: true, maximumAge: 10000, timeout: 20000 },
    );
  }

  // Button-driven locate: a one-shot fix that always recenters. Unlike the
  // passive watch it fires fresh on every tap and reports failures, so tapping
  // does something visible even when the on-load watch was denied or pending.
  function locateNow() {
    if (!('geolocation' in navigator)) { flash('This browser can’t share location.'); return; }
    flash('Locating…', true);
    navigator.geolocation.getCurrentPosition(
      (pos) => onFix(pos, true),
      (err) => onError(err, true),
      { enableHighAccuracy: true, maximumAge: 0, timeout: 20000 },
    );
    startLocating(); // keep the live watch going for continued tracking
  }

  const LocateCtl = L.Control.extend({
    onAdd: function () {
      const a = L.DomUtil.create('a', 'leaflet-bar locate-btn');
      a.href = '#'; a.title = 'Center on my location'; a.setAttribute('role', 'button');
      a.setAttribute('aria-label', 'Center on my location');
      a.innerHTML =
        `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">` +
        `<path fill="none" stroke="currentColor" stroke-width="2" d="M12 8a4 4 0 100 8 4 4 0 000-8zM12 2v3M12 19v3M2 12h3M19 12h3"/></svg>`;
      L.DomEvent.disableClickPropagation(a);
      L.DomEvent.on(a, 'click', L.DomEvent.stop);
      L.DomEvent.on(a, 'click', () => {
        if (userMarker) map.setView(userMarker.getLatLng(), Math.max(map.getZoom(), 16), { animate: true });
        else locateNow();
      });
      return a;
    },
  });
  new LocateCtl({ position: 'topleft' }).addTo(map);

  // Auto-locate on the dedicated fullscreen map (clear intent); the home embed
  // waits for a button tap so a homepage visit doesn't fire a permission prompt.
  if (isFullMap) startLocating();

  const usedCats = new Set<string>();

  // ── Layers panel (fullscreen map) ────────────────────────────────────────
  // One collapsible panel in the bottom-right (thumb reach) holding BOTH the
  // verified-pin legend and the scouting-leads filter. Collapsed by default so
  // it doesn't eat the screen; open state persists per-device. loadSpots() fills
  // the legend section, initScouting() fills the scouting section — both write
  // into the sections this creates, so it must exist before either runs.
  let panelLegendEl: HTMLElement | null = null;
  let panelScoutEl: HTMLElement | null = null;

  function initPanel() {
    let open = loadPref('panel.open', false);
    const PanelCtl = L.Control.extend({
      onAdd: function () {
        const wrap = L.DomUtil.create('div', 'map-panel' + (open ? ' open' : ''));
        L.DomEvent.disableClickPropagation(wrap);
        L.DomEvent.disableScrollPropagation(wrap);
        wrap.innerHTML =
          `<button type="button" class="map-panel-toggle" aria-expanded="${open}" aria-label="Map layers & legend">` +
            `<svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">` +
              `<path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" d="M12 3l9 5-9 5-9-5 9-5zM3 12l9 5 9-5M3 16l9 5 9-5"/></svg>` +
            `<span>Layers</span></button>` +
          `<div class="map-panel-body"${open ? '' : ' hidden'}>` +
            `<div class="panel-sec" id="panel-legend" hidden></div>` +
            `<div class="panel-sec scout-ctl" id="panel-scout" hidden></div>` +
          `</div>`;
        const btn = wrap.querySelector('.map-panel-toggle') as HTMLElement;
        const body = wrap.querySelector('.map-panel-body') as HTMLElement;
        panelLegendEl = wrap.querySelector('#panel-legend');
        panelScoutEl = wrap.querySelector('#panel-scout');
        btn.addEventListener('click', () => {
          open = !open;
          savePref('panel.open', open);
          wrap.classList.toggle('open', open);
          body.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
        });
        return wrap;
      },
    });
    new PanelCtl({ position: 'bottomright' }).addTo(map);
  }
  if (isFullMap) initPanel();

  // Optional ?plant=<slug> filter: a plant page can deep-link here to show only
  // the spots that link back to it (properties.plant === slug).
  const plantFilter = new URLSearchParams(location.search).get('plant');

  // ── Edit mode (?edit=1) ─────────────────────────────────────────────────
  // Pins become draggable so you can correct a spot whose photo-geolocation
  // landed it in the wrong place (the far side of a fence, etc.). Dropping a pin
  // PATCHes the live API, which persists it to the DB — no rebuild, shows for
  // everyone on the next load. Writes need the edit token (stored per-device).
  const editMode = new URLSearchParams(location.search).get('edit') === '1';
  const TOKEN_KEY = 'forage.editToken';
  const getToken = () => { try { return localStorage.getItem(TOKEN_KEY) || ''; } catch { return ''; } };
  const setToken = (t: string) => { try { localStorage.setItem(TOKEN_KEY, t); } catch {} };
  const clearToken = () => { try { localStorage.removeItem(TOKEN_KEY); } catch {} };
  function ensureToken(): string {
    let t = getToken();
    if (!t) {
      const entered = window.prompt('Enter your edit token to save pin moves:');
      if (entered) { t = entered.trim(); setToken(t); }
    }
    return t;
  }

  async function saveMove(id: number, marker: any, origin: any) {
    const token = ensureToken();
    if (!token) { marker.setLatLng(origin); flash('No token — move not saved.'); return; }
    const { lat, lng } = marker.getLatLng();
    flash('Saving…', true);
    try {
      const r = await fetch('/api/pins/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
        body: JSON.stringify({ lon: +lng.toFixed(6), lat: +lat.toFixed(6) }),
      });
      if (r.status === 401) { clearToken(); marker.setLatLng(origin); flash('Edit token rejected — moved back. Drag again to re-enter it.', true); return; }
      if (!r.ok) { const e = await r.json().catch(() => ({})); throw new Error(e.error || ('HTTP ' + r.status)); }
      flash('Saved ✓');
    } catch (err: any) {
      marker.setLatLng(origin);
      flash('Save failed (' + (err?.message || err) + ') — moved back.');
    }
  }

  // Long-press to move (mobile-safe). Pins are inert to touch by default so you
  // can pan the map freely; press-and-hold ~0.45s on a pin to "lift" it, then drag
  // and release to drop. Moving the finger before the hold completes is treated as
  // a pan and never grabs the pin — which was the old draggable-marker footgun.
  function enableLongPressMove(marker: any, id: number) {
    const ARM_MS = 450, SLOP = 10;
    let timer: any = null, armed = false, start: any = null, originLL: any = null;

    const arm = () => {
      armed = true;
      originLL = marker.getLatLng();
      map.dragging.disable();               // don't pan while a pin is lifted
      marker.getElement()?.classList.add('pin-armed');
      try { (navigator as any).vibrate?.(30); } catch {}
      flash('Pin lifted — drag to move, release to drop.', true);
    };
    const disarm = () => {
      map.dragging.enable();
      marker.getElement()?.classList.remove('pin-armed');
    };
    const onMove = (e: any) => {
      if (!armed) {
        // A move before the hold completes = a pan/tap; abandon arming.
        if (start && Math.hypot(e.clientX - start.x, e.clientY - start.y) > SLOP) { clearTimeout(timer); cleanup(); }
        return;
      }
      e.preventDefault();
      marker.setLatLng(map.mouseEventToLatLng(e));
    };
    const onUp = (e: any) => {
      clearTimeout(timer);
      if (armed) {
        e.preventDefault?.();
        disarm();
        suppressNextClick(marker.getElement()); // don't pop the popup right after a move
        saveMove(id, marker, originLL);
      }
      cleanup();
    };
    const onCancel = () => {
      clearTimeout(timer);
      if (armed) { marker.setLatLng(originLL); disarm(); }
      cleanup();
    };
    const cleanup = () => {
      armed = false; start = null;
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      window.removeEventListener('pointercancel', onCancel);
    };
    const onDown = (e: any) => {
      if (e.button != null && e.button > 0) return; // primary button / touch only
      start = { x: e.clientX, y: e.clientY };
      timer = setTimeout(arm, ARM_MS);
      window.addEventListener('pointermove', onMove, { passive: false });
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', onCancel);
    };
    marker.on('add', () => marker.getElement()?.addEventListener('pointerdown', onDown));
  }

  function suppressNextClick(el: any) {
    if (!el) return;
    const h = (ev: any) => { ev.stopPropagation(); ev.preventDefault(); el.removeEventListener('click', h, true); };
    el.addEventListener('click', h, true);
    setTimeout(() => el.removeEventListener('click', h, true), 500);
  }

  // Pins load live from the API; fall back to the build-time static export if the
  // API is unreachable, so the map still renders when the service is down.
  async function loadSpots() {
    try {
      const r = await fetch('/api/pins', { cache: 'no-store' });
      if (r.ok) return await r.json();
    } catch {}
    const r = await fetch('/data/foraging-spots.geojson?t=' + Date.now(), { cache: 'no-store' });
    return r.json();
  }

  loadSpots()
    .then((geo) => {
      if (editMode) flash('✎ Edit mode — press & hold a pin to lift it, then drag to its real spot.', true);
      const layer = L.geoJSON(geo, {
        filter: (feature) =>
          !plantFilter || feature.properties?.plant === plantFilter,
        pointToLayer: (feature, latlng) => {
          const cat = feature.properties?.category || 'other';
          usedCats.add(cat);
          return L.marker(latlng, { icon: pinIcon(CAT_COLORS[cat] || CAT_COLORS.other) });
        },
        onEachFeature: (feature, lyr) => {
          const p = feature.properties || {};
          if (editMode && typeof feature.id === 'number') {
            enableLongPressMove(lyr, feature.id as number);
          }
          const photos: string[] = Array.isArray(p.photos) ? p.photos : [];
          const imgs = photos
            .map((f) => `<a href="/photos/spots/${seg(f)}" target="_blank" rel="noopener"><img src="/photos/spots/${seg(f)}" alt="${esc(p.name)}" loading="lazy" /></a>`)
            .join('');
          lyr.bindPopup(
            `<div class="p-pop">` +
              `<h3>${esc(p.name) || 'Spot'}</h3>` +
              (p.species ? `<div class="p-sci">${esc(p.species)}</div>` : '') +
              (p.season ? `<div class="p-meta">🗓 ${esc(p.season)}</div>` : '') +
              (p.location ? `<div class="p-meta">📍 ${esc(p.location)}</div>` : '') +
              (p.notes ? `<div class="p-meta">${esc(p.notes)}</div>` : '') +
              imgs +
              (p.plant ? `<a class="p-guide" href="/plants/${seg(p.plant)}">View plant guide →</a>` : '') +
            `</div>`,
            // Keep popups compact so they never overflow the viewport; the inner
            // content scrolls if long, and Leaflet pans to keep it in view.
            { maxWidth: 244, minWidth: 200, maxHeight: 300, autoPan: true, keepInView: true },
          );
        },
      }).addTo(map);

      try {
        const b = layer.getBounds();
        // Keep bounds for the geolocation "near the spots?" test; only fit them
        // if the user hasn't already been located and centered.
        if (b.isValid()) { spotsBounds = b; if (!didLocate) map.fitBounds(b.pad(0.35)); }
      } catch {}

      // When deep-linked to one plant, show a banner + "show all" reset. Label
      // uses that plant's species text from the first matching feature.
      const filterEl = document.getElementById('map-filter');
      if (filterEl && plantFilter) {
        const match = (geo.features || []).find(
          (f: any) => f.properties?.plant === plantFilter,
        );
        const label = match?.properties?.species || match?.properties?.name || plantFilter;
        const n = layer.getLayers().length;
        filterEl.innerHTML =
          `<span>Showing ${n} spot${n === 1 ? '' : 's'} for <strong>${esc(label)}</strong>.</span>` +
          `<a href="/map">Show all spots →</a>`;
        filterEl.hidden = false;
      }

      // Re-measure once the container has its final (flex/fullscreen) size.
      setTimeout(() => map.invalidateSize(), 60);

      const legendItems = [...usedCats]
        .sort()
        .map((c) => `<span><i class="dot" style="background:${CAT_COLORS[c] || CAT_COLORS.other}"></i>${esc(c)}</span>`)
        .join('');
      // Fullscreen: the legend lives inside the collapsible bottom-right panel.
      // Home embed: it stays inline below the map.
      if (isFullMap && panelLegendEl) {
        panelLegendEl.innerHTML = `<h4 class="panel-h">Foraging spots</h4><div class="legend">${legendItems}</div>`;
        panelLegendEl.hidden = false;
      } else {
        const legend = document.getElementById('legend');
        if (legend) legend.innerHTML = legendItems;
      }
    })
    .catch((err) => {
      if (mapEl) mapEl.innerHTML = '<p style="padding:20px">Could not load map data.</p>';
      console.error(err);
    });

  // ── Scouting layer ──────────────────────────────────────────────────────
  // Only on the fullscreen map page, never the home embed. Unverified iNat
  // leads, off by default; visibility + per-tier filter persist in localStorage.
  const isMapPage = document.querySelector('.map-wrap')?.classList.contains('full');
  if (isMapPage && !plantFilter) initScouting();

  function loadPref(key: string, fallback: boolean) {
    try { const v = localStorage.getItem(key); return v === null ? fallback : v === '1'; }
    catch { return fallback; }
  }
  function savePref(key: string, on: boolean) {
    try { localStorage.setItem(key, on ? '1' : '0'); } catch {}
  }

  // Locally-hidden scouting pins (e.g. one that turned out to sit in someone's
  // private garden). Stored as a set of iNat observation ids in localStorage, so
  // a hide is stable across reloads AND across data regenerations (the id keys
  // the observation, not an array index). Per-device by nature.
  function loadHidden(): Set<number> {
    try { return new Set(JSON.parse(localStorage.getItem('scout.hidden') || '[]')); }
    catch { return new Set(); }
  }
  function saveHidden(s: Set<number>) {
    try { localStorage.setItem('scout.hidden', JSON.stringify([...s])); } catch {}
  }

  function scoutPopup(p: any, id: number) {
    const tier = p.tier || 'snack';
    return (
      `<div class="p-pop">` +
        `<h3>${esc(p.name) || 'Observation'}</h3>` +
        (p.species ? `<div class="p-sci">${esc(p.species)}</div>` : '') +
        `<div class="p-tier tier-${esc(tier)}">${TIER_LABEL[tier] || esc(tier)}</div>` +
        (p.notes ? `<div class="p-meta">${esc(p.notes)}</div>` : '') +
        (p.observed ? `<div class="p-meta p-obs">🔍 iNat obs ${esc(p.observed)}${p.observer ? ' · @' + esc(p.observer) : ''}${p.obscured ? ' · ⚠ location obscured' : ''}</div>` : '') +
        (/^https?:\/\//i.test(p.inat || '') ? `<a class="p-guide" href="${esc(p.inat)}" target="_blank" rel="noopener">View on iNaturalist →</a>` : '') +
        (p.plant ? `<a class="p-guide" href="/plants/${seg(p.plant)}">View plant guide →</a>` : '') +
        `<button type="button" class="scout-hide" data-hide="${id}">✕ Hide this pin</button>` +
      `</div>`
    );
  }

  function initScouting() {
    fetch('/data/scouting-spots.geojson?t=' + Date.now(), { cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : Promise.reject('no scouting data')))
      .then((geo) => {
        const groups: Record<string, any> = {};
        for (const t of TIER_ORDER) groups[t] = L.layerGroup();
        const tiersPresent = new Set<string>();
        const hidden = loadHidden();
        // Every marker kept by id+tier so we can hide/unhide without a reload.
        const records: Array<{ id: number; tier: string; marker: any }> = [];

        (geo.features || []).forEach((f: any, i: number) => {
          const p = f.properties || {};
          const tier = p.tier || 'snack';
          if (!groups[tier]) return;
          tiersPresent.add(tier);
          const id = typeof f.id === 'number' ? f.id : i;
          const [lon, lat] = f.geometry.coordinates;
          const marker = L.marker([lat, lon], { icon: scoutIcon(TIER_COLORS[tier] || '#7a7a7a') })
            .bindPopup(scoutPopup(p, id), { maxWidth: 244, minWidth: 200, maxHeight: 300, autoPan: true, keepInView: true });
          records.push({ id, tier, marker });
          if (!hidden.has(id)) groups[tier].addLayer(marker);
        });
        if (!tiersPresent.size) return;

        // Live, mutable UI state — read by apply() on every change; persisted.
        const state = { master: loadPref('scout.on', false), tier: {} as Record<string, boolean> };
        for (const t of TIER_ORDER) state.tier[t] = loadPref('scout.tier.' + t, true);

        const apply = () => {
          for (const t of TIER_ORDER) {
            if (!tiersPresent.has(t)) continue;
            const show = state.master && state.tier[t];
            if (show && !map.hasLayer(groups[t])) groups[t].addTo(map);
            else if (!show && map.hasLayer(groups[t])) map.removeLayer(groups[t]);
          }
        };
        apply();

        let renderCtl = () => {};
        const hidePin = (id: number) => {
          const rec = records.find((r) => r.id === id);
          if (!rec) return;
          hidden.add(id);
          saveHidden(hidden);
          groups[rec.tier].removeLayer(rec.marker);
          map.closePopup();
          renderCtl();
        };
        const unhideAll = () => {
          for (const rec of records) if (hidden.has(rec.id)) groups[rec.tier].addLayer(rec.marker);
          hidden.clear();
          saveHidden(hidden);
          apply();
          renderCtl();
        };
        // Popups are HTML strings — wire their Hide button when the popup opens.
        map.on('popupopen', (e: any) => {
          const btn = e.popup.getElement()?.querySelector('.scout-hide');
          if (btn) btn.addEventListener('click', () => hidePin(Number(btn.dataset.hide)), { once: true });
        });

        // The scouting UI renders into the shared bottom-right layers panel's
        // scouting section (created by initPanel, alongside the legend).
        const div = panelScoutEl;
        if (!div) return; // no panel (not the fullscreen map) — nothing to draw into
        div.hidden = false;
        const tiers = TIER_ORDER.filter((t) => tiersPresent.has(t));
        renderCtl = () => {
          div.innerHTML =
            `<h4 class="panel-h">Scouting leads <em>iNat · unverified</em></h4>` +
            `<label class="scout-master"><input type="checkbox" id="scout-master"${state.master ? ' checked' : ''}>` +
            `<span>Show on map</span></label>` +
            `<div class="scout-tiers"${state.master ? '' : ' hidden'} id="scout-tiers">` +
            tiers.map((t) =>
              `<label class="scout-tier"><input type="checkbox" data-tier="${t}"${state.tier[t] ? ' checked' : ''}>` +
              `<i class="dot" style="background:${TIER_COLORS[t]}"></i>${TIER_LABEL[t]} <b>${groups[t].getLayers().length}</b></label>`,
            ).join('') +
            (hidden.size ? `<button type="button" class="scout-unhide">↺ Restore ${hidden.size} hidden pin${hidden.size === 1 ? '' : 's'}</button>` : '') +
            `</div>`;
          const masterEl = div.querySelector('#scout-master') as HTMLInputElement;
          const tiersEl = div.querySelector('#scout-tiers') as HTMLElement;
          masterEl.addEventListener('change', () => {
            state.master = masterEl.checked;
            savePref('scout.on', state.master);
            tiersEl.hidden = !state.master;
            apply();
          });
          div.querySelectorAll('input[data-tier]').forEach((el) => {
            el.addEventListener('change', () => {
              const t = (el as HTMLInputElement).dataset.tier as string;
              state.tier[t] = (el as HTMLInputElement).checked;
              savePref('scout.tier.' + t, state.tier[t]);
              apply();
            });
          });
          const unhideEl = div.querySelector('.scout-unhide');
          if (unhideEl) unhideEl.addEventListener('click', unhideAll);
        };
        renderCtl();
      })
      .catch(() => { /* no scouting layer for this deploy */ });
  }

  window.addEventListener('resize', () => map.invalidateSize());
  void isTouch;
</script>
