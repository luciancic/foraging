---
// Client-side Leaflet map. Pins load live from the /api/pins data API (the SQLite
// DB is the source of truth), falling back to the build-time static export at
// /data/foraging-spots.geojson if the API is unreachable.
// `fullscreen` makes the map fill the viewport below the header (map page);
// otherwise it's a boxed embed (home page).
import { getPlants } from '../lib/content.mjs';
interface Props { fullscreen?: boolean; }
const { fullscreen = false } = Astro.props;

// The contribute flow lets a visitor pick WHICH plant a new pin is — the pin then
// inherits the plant's name/category/species from its guide, so there are no free
// text/category fields to fill. Ship the guide catalog (slug → title/category/
// species) to the client as a small JSON island the add-sheet reads at runtime.
const plantCatalog = getPlants()
  // A pin is single-category: send the plant's PRIMARY category (list[0]) so an
  // added spot inherits one colour, matching the pins-follow-plants data model.
  .map((p) => ({ slug: p.id, title: p.data.title, category: p.data.category[0], species: p.data.scientificName || '' }))
  .sort((a, b) => a.title.localeCompare(b.title));
---
<div class={`map-wrap${fullscreen ? ' full' : ''}`}>
  <div class="map-shell"><div id="map"></div></div>
  <div class="legend" id="legend"></div>
  <script type="application/json" id="plant-catalog" set:html={JSON.stringify(plantCatalog)}></script>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" crossorigin="" />

<script>
  import L from 'leaflet';
  import 'leaflet.markercluster';

  // ONE colour axis for every pin: category (what it is / which food part). Shape
  // encodes provenance — confirmed spots are prominent teardrops, leads are smaller
  // source-shaped markers (circle iNat / diamond FF / triangle city). An amber ring
  // flags a dangerous lookalike (`caution`), the one bit of the old tier system
  // worth keeping. No second colour system.
  const CAT_COLORS: Record<string, string> = {
    fruit: '#8a2f4a', nuts: '#8a6d3b', greens: '#2f7d4f', herbs: '#4a8f7b',
    sap: '#caa03e', mushrooms: '#9c6b4a', other: '#7a7a7a',
  };
  const CAT_LABEL: Record<string, string> = {
    fruit: 'Fruit & berries', nuts: 'Nuts', greens: 'Greens', herbs: 'Herbs & tea',
    sap: 'Sap & syrup', mushrooms: 'Mushrooms', other: 'Other',
  };
  const CAT_ORDER = ['fruit', 'nuts', 'greens', 'herbs', 'sap', 'mushrooms', 'other'];
  const CATEGORIES = CAT_ORDER;
  const CAUTION_COLOR = '#d98a2b';
  const SRC_LABEL: Record<string, string> = {
    confirmed: 'My spot', inat: 'iNaturalist', fallingfruit: 'Falling Fruit', montreal: 'Ville de Montréal',
  };

  // Popups are built as HTML strings, so any text that originates from the DB
  // (pin fields) or third parties (iNaturalist usernames on scouting pins) must be
  // escaped before interpolation. `seg` makes a value safe inside an href/src path.
  const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]);
  const seg = (s: any) => encodeURIComponent(String(s ?? ''));

  // Confirmed spot: a prominent teardrop, category-coloured. A caution find gets an
  // amber outline so a dangerous-lookalike still reads at a glance.
  function pinIcon(color: string, caution = false) {
    const stroke = caution ? ` stroke="${CAUTION_COLOR}" stroke-width="2.6"` : '';
    const svg =
      `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="40" viewBox="0 0 28 40">` +
      `<path d="M14 0C6.3 0 0 6.2 0 13.9 0 24 14 40 14 40s14-16 14-26.1C28 6.2 21.7 0 14 0z" fill="${color}"${stroke}/>` +
      `<circle cx="14" cy="14" r="5.4" fill="#fff"/></svg>`;
    return L.divIcon({
      className: 'forage-pin' + (caution ? ' is-caution' : ''),
      html: svg,
      iconSize: [28, 40],
      iconAnchor: [14, 40],
      popupAnchor: [0, -38],
    });
  }

  // Lead: smaller marker, SHAPE = source (circle iNat / diamond FF / triangle city),
  // FILL = category. White ring normally; amber ring when caution.
  function leadIcon(shape: string, color: string, caution = false) {
    const ring = caution ? CAUTION_COLOR : '#fff';
    const w = caution ? 3 : 2.5;
    let body: string, anchorY = 10, cls = 'scout-pin';
    if (shape === 'diamond') {
      body = `<rect x="4.5" y="4.5" width="11" height="11" transform="rotate(45 10 10)" fill="${color}" fill-opacity="0.85" stroke="${ring}" stroke-width="${w}"/>`;
      cls += ' scout-diamond';
    } else if (shape === 'triangle') {
      body = `<path d="M10 3.2 17 16.4H3z" fill="${color}" fill-opacity="0.85" stroke="${ring}" stroke-width="${caution ? 2.8 : 2.2}" stroke-linejoin="round"/>`;
      cls += ' scout-triangle'; anchorY = 11;
    } else {
      body = `<circle cx="10" cy="10" r="7" fill="${color}" fill-opacity="0.85" stroke="${ring}" stroke-width="${w}"/>`;
    }
    if (caution) cls += ' is-caution';
    return L.divIcon({
      className: cls,
      html: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20">${body}</svg>`,
      iconSize: [20, 20], iconAnchor: [10, anchorY], popupAnchor: [0, -10],
    });
  }
  const SOURCE_SHAPE: Record<string, string> = { inat: 'circle', fallingfruit: 'diamond', montreal: 'triangle' };

  const mapEl = document.getElementById('map');
  const isTouch = window.matchMedia('(pointer: coarse)').matches;

  const map = L.map('map', {
    scrollWheelZoom: false,   // desktop: unlock on click so page-scroll isn't hijacked
    tap: true,
  }).setView([45.462, -73.565], 13);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; OpenStreetMap contributors',
  }).addTo(map);
  map.on('click', () => map.scrollWheelZoom.enable());

  // ── User location ─────────────────────────────────────────────────────────
  // A "you are here" dot + accuracy halo. On the first fix we recenter the map
  // on the user (so they land in their area instead of the Montréal overview) —
  // unless they're far (>150 km) from the logged spots, where we keep the
  // overview. The locate button forces a fresh fix and surfaces a message when
  // the browser blocks/‌can't provide location (so it's never a silent no-op).
  let userMarker: any = null, accCircle: any = null;
  let didLocate = false, spotsBounds: any = null;
  const isFullMap = document.querySelector('.map-wrap')?.classList.contains('full');

  const userIcon = L.divIcon({
    className: 'user-loc',
    html: `<div class="user-dot"></div>`,
    iconSize: [24, 24],
    iconAnchor: [12, 12],
  });

  // A transient status line over the map (denied / unavailable / locating…).
  let msgTimer: any = null;
  function flash(text: string, sticky = false) {
    let el = document.getElementById('map-msg');
    if (!el) {
      el = document.createElement('div');
      el.id = 'map-msg';
      el.className = 'map-msg';
      (mapEl?.parentElement || mapEl)?.appendChild(el);
    }
    el.textContent = text;
    el.hidden = false;
    clearTimeout(msgTimer);
    if (!sticky) msgTimer = setTimeout(() => { if (el) el.hidden = true; }, 4000);
  }
  function clearFlash() {
    const el = document.getElementById('map-msg');
    if (el) el.hidden = true;
    clearTimeout(msgTimer);
  }

  function updatePosition(lat: number, lon: number, acc: number) {
    const ll = L.latLng(lat, lon);
    if (!userMarker) {
      userMarker = L.marker(ll, { icon: userIcon, interactive: false, keyboard: false, zIndexOffset: 1000 }).addTo(map);
      accCircle = L.circle(ll, {
        radius: acc || 0, interactive: false,
        color: '#1a73e8', weight: 1, opacity: 0.25, fillColor: '#1a73e8', fillOpacity: 0.12,
      }).addTo(map);
    } else {
      userMarker.setLatLng(ll);
      accCircle.setLatLng(ll).setRadius(acc || 0);
    }
  }

  function firstFix(ll: any) {
    if (didLocate) return;
    didLocate = true;
    // Center on the user unless they're far (>150 km) from the logged spots.
    const near = !spotsBounds || map.distance(ll, spotsBounds.getCenter()) < 150000;
    if (near) map.setView(ll, Math.max(map.getZoom(), 15), { animate: true });
  }

  function onFix(pos: any, recenter: boolean) {
    clearFlash();
    const { latitude, longitude, accuracy } = pos.coords;
    updatePosition(latitude, longitude, accuracy);
    if (recenter && addMode && addCross) {
      // While adding, drop the crosshair (where the pin lands) on the fix.
      centerCrosshairOn(latitude, longitude, 16);
      setLocText('Placed on your location — pan to fine-tune.');
    } else if (recenter) map.setView([latitude, longitude], Math.max(map.getZoom(), 16), { animate: true });
    else firstFix(L.latLng(latitude, longitude));
  }

  function onError(err: any, loud: boolean) {
    if (!loud) return; // the silent passive watch shouldn't nag on load
    if (err && err.code === 1) flash('Location is blocked. Enable it for this site in your browser settings.', true);
    else flash('Couldn’t get your location — try again outdoors with a clear sky.');
  }

  let locating = false;
  function startLocating() {
    if (locating || !('geolocation' in navigator)) return;
    locating = true;
    navigator.geolocation.watchPosition(
      (pos) => onFix(pos, false),
      (err) => onError(err, false),
      { enableHighAccuracy: true, maximumAge: 10000, timeout: 20000 },
    );
  }

  // Button-driven locate: a one-shot fix that always recenters. Unlike the
  // passive watch it fires fresh on every tap and reports failures, so tapping
  // does something visible even when the on-load watch was denied or pending.
  function locateNow() {
    if (!('geolocation' in navigator)) { flash('This browser can’t share location.'); return; }
    flash('Locating…', true);
    navigator.geolocation.getCurrentPosition(
      (pos) => onFix(pos, true),
      (err) => onError(err, true),
      { enableHighAccuracy: true, maximumAge: 0, timeout: 20000 },
    );
    startLocating(); // keep the live watch going for continued tracking
  }

  const LocateCtl = L.Control.extend({
    onAdd: function () {
      const a = L.DomUtil.create('a', 'leaflet-bar locate-btn');
      a.href = '#'; a.title = 'Center on my location'; a.setAttribute('role', 'button');
      a.setAttribute('aria-label', 'Center on my location');
      a.innerHTML =
        `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">` +
        `<path fill="none" stroke="currentColor" stroke-width="2" d="M12 8a4 4 0 100 8 4 4 0 000-8zM12 2v3M12 19v3M2 12h3M19 12h3"/></svg>`;
      L.DomEvent.disableClickPropagation(a);
      L.DomEvent.on(a, 'click', L.DomEvent.stop);
      L.DomEvent.on(a, 'click', () => {
        if (userMarker) map.setView(userMarker.getLatLng(), Math.max(map.getZoom(), 16), { animate: true });
        else locateNow();
      });
      return a;
    },
  });
  new LocateCtl({ position: 'topleft' }).addTo(map);

  // Auto-locate on the dedicated fullscreen map (clear intent); the home embed
  // waits for a button tap so a homepage visit doesn't fire a permission prompt.
  if (isFullMap) startLocating();


  // ── Layers panel (fullscreen map) ────────────────────────────────────────
  // One collapsible panel in the bottom-right (thumb reach) holding the layer
  // toggles (My spots + each lead source) and the type/caution filters. Collapsed
  // by default so it doesn't eat the screen; open state persists per-device.
  // initFullMap() writes into #panel-scout, which must exist before it runs.
  let panelLegendEl: HTMLElement | null = null;
  let panelScoutEl: HTMLElement | null = null;

  // ── Edit mode (?edit=1) ─────────────────────────────────────────────────
  // Pins become draggable so you can correct a spot whose photo-geolocation
  // landed it in the wrong place (the far side of a fence, etc.). Dropping a pin
  // PATCHes the live API, which persists it to the DB — no rebuild, shows for
  // everyone on the next load. Writes need the edit token (stored per-device).
  // Defined above initPanel so the panel's pencil toggle can gate on the token.
  // `editMode` is a live `let`, not a load-time const: the pencil flips it in
  // place (no reload, so map position/zoom are preserved) — long-press-move and
  // the promote button react to the current value rather than being wired once.
  let editMode = new URLSearchParams(location.search).get('edit') === '1';
  let editBtnEl: HTMLElement | null = null;
  const EDIT_MSG = '✎ Edit mode — press & hold a pin to move it, or open a pin to promote (leads) or delete it.';
  const TOKEN_KEY = 'forage.editToken';
  const getToken = () => { try { return localStorage.getItem(TOKEN_KEY) || ''; } catch { return ''; } };
  const setToken = (t: string) => { try { localStorage.setItem(TOKEN_KEY, t); } catch {} };
  const clearToken = () => { try { localStorage.removeItem(TOKEN_KEY); } catch {} };
  function ensureToken(): string {
    let t = getToken();
    if (!t) {
      const entered = window.prompt('Enter your edit token to save pin moves:');
      if (entered) { t = entered.trim(); setToken(t); }
    }
    return t;
  }

  // ── Contributor identity (name-only, self-asserted) ───────────────────────
  // A named contributor can add a spot with just a name — no token. We keep an
  // { id, name } beside the admin token: `id` is a client-generated handle the
  // server upserts into `users`, `name` is what shows in the pin history. Asked
  // once (first contribution) and reused; the name is claimed, never verified.
  const USER_KEY = 'forage.user';
  type Actor = { id: string; name: string };
  function getUser(): Actor | null {
    try { const u = JSON.parse(localStorage.getItem(USER_KEY) || 'null'); return u && u.name ? u : null; } catch { return null; }
  }
  function saveUser(u: Actor) { try { localStorage.setItem(USER_KEY, JSON.stringify(u)); } catch {} }
  function newId(): string {
    try { return (crypto as any).randomUUID(); } catch {}
    return 'u-' + Math.abs(Math.floor((performance.now() % 1e9) * 1000)).toString(36) + Math.floor(performance.now()).toString(36);
  }
  // Ensure we have a name to attribute the write to; prompt once, then remember.
  function ensureUser(): Actor | null {
    const existing = getUser();
    if (existing) return existing;
    const entered = window.prompt('Add spots as — your first name or handle (shown in the pin history):');
    const name = (entered || '').trim();
    if (!name) return null;
    const u: Actor = { id: newId(), name: name.slice(0, 80) };
    saveUser(u);
    return u;
  }

  // Assigned by initFullMap so the add-sheet can drop a freshly-created confirmed
  // pin straight into the live cluster (no reload). No-op until the map is built.
  let onSpotAdded: (spot: any) => void = () => {};

  // Reflect the current editMode onto the DOM: a body class drives promote-button
  // visibility (popups are HTML, so CSS gates them reactively) and the pencil's
  // fill/label. Called on load and on every toggle.
  function applyEditState() {
    document.body.classList.toggle('map-editing', editMode);
    // Persistent edit-mode banner — its OWN element, deliberately NOT the transient
    // flash line: flash() messages (Saving…, Pin lifted, Locating…) and clearFlash()
    // on each geolocation fix would otherwise wipe it while still editing.
    let banner = document.getElementById('edit-banner');
    if (editMode && !banner) {
      banner = document.createElement('div');
      banner.id = 'edit-banner';
      banner.className = 'edit-banner';
      banner.textContent = EDIT_MSG;
      (mapEl?.parentElement || mapEl)?.appendChild(banner);
    }
    if (banner) banner.hidden = !editMode;
    if (editBtnEl) {
      const t = editMode ? 'Exit edit mode' : 'Edit mode — move pins, promote leads';
      editBtnEl.classList.toggle('active', editMode);
      editBtnEl.title = t;
      editBtnEl.setAttribute('aria-label', t);
      editBtnEl.setAttribute('aria-pressed', String(editMode));
    }
  }
  // Flip edit mode without reloading — keep ?edit in the URL in sync (replaceState,
  // so it's still shareable/bookmarkable) but leave the map view untouched.
  function setEditMode(on: boolean) {
    editMode = on;
    const u = new URL(location.href);
    if (on) u.searchParams.set('edit', '1'); else u.searchParams.delete('edit');
    history.replaceState(null, '', u);
    applyEditState();          // shows/hides the persistent edit banner
    if (!on) clearFlash();     // drop any leftover transient message on exit
  }

  function initPanel() {
    let open = loadPref('panel.open', false);
    // The pencil edit-toggle sits to the LEFT of the Layers pill on the same row,
    // but only once an edit token is stored (never shown to public visitors).
    // Clicking flips edit mode in place (setEditMode) — no reload, so the map view
    // is preserved.
    const canEdit = !!getToken();
    const editTitle = editMode ? 'Exit edit mode' : 'Edit mode — move pins, promote leads';
    const PanelCtl = L.Control.extend({
      onAdd: function () {
        const wrap = L.DomUtil.create('div', 'map-panel' + (open ? ' open' : ''));
        L.DomEvent.disableClickPropagation(wrap);
        L.DomEvent.disableScrollPropagation(wrap);
        wrap.innerHTML =
          `<div class="map-panel-bar">` +
            // ➕ Add a spot — shown to everyone (name-gated, not token-gated). The
            // primary contributor CTA, so it leads the bar with a filled accent.
            `<button type="button" class="map-panel-add" title="Add a foraging spot" aria-label="Add a foraging spot">` +
              `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">` +
                `<path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>` +
            `</button>` +
            (canEdit
              ? `<button type="button" class="map-panel-edit${editMode ? ' active' : ''}" aria-pressed="${editMode}" title="${editTitle}" aria-label="${editTitle}">` +
                  `<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">` +
                    `<path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" d="M4 20l4.5-1L20 7.5 16.5 4 5 15.5 4 20zM14.5 6l3.5 3.5"/></svg>` +
                `</button>`
              : '') +
            `<button type="button" class="map-panel-toggle" aria-expanded="${open}" aria-label="Map layers & legend">` +
              `<svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">` +
                `<path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" d="M12 3l9 5-9 5-9-5 9-5zM3 12l9 5 9-5M3 16l9 5 9-5"/></svg>` +
              `<span>Layers</span></button>` +
          `</div>` +
          `<div class="map-panel-body"${open ? '' : ' hidden'}>` +
            `<div class="panel-sec" id="panel-legend" hidden></div>` +
            `<div class="panel-sec scout-ctl" id="panel-scout" hidden></div>` +
          `</div>`;
        const btn = wrap.querySelector('.map-panel-toggle') as HTMLElement;
        const body = wrap.querySelector('.map-panel-body') as HTMLElement;
        panelLegendEl = wrap.querySelector('#panel-legend');
        panelScoutEl = wrap.querySelector('#panel-scout');
        btn.addEventListener('click', () => {
          open = !open;
          savePref('panel.open', open);
          wrap.classList.toggle('open', open);
          body.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
        });
        editBtnEl = wrap.querySelector('.map-panel-edit') as HTMLElement | null;
        if (editBtnEl) editBtnEl.addEventListener('click', () => setEditMode(!editMode));
        const addBtn = wrap.querySelector('.map-panel-add') as HTMLElement | null;
        if (addBtn) addBtn.addEventListener('click', () => startAddMode());
        return wrap;
      },
    });
    new PanelCtl({ position: 'bottomright' }).addTo(map);
  }
  if (isFullMap) initPanel();
  applyEditState(); // reflect the initial ?edit state onto body + pencil

  // ── Deep-link filters (query string) ─────────────────────────────────────
  // The map opens in normal mode with filters pre-applied from the URL, so a plant
  // guide can link straight to its pins and any filter view is shareable:
  //   ?plants=raspberry,blackberry   show ONLY these plants (include)
  //   ?except=apple                  show all plants EXCEPT these (exclude)
  //   ?ripe=1                        only plants in season right now
  //   ?cat=fruit,greens              only these category types
  //   ?plant=<slug>                  back-compat alias for a single ?plants entry
  // The plant filter is exclude-by-default: every plant shows unless unchecked, so
  // "ripe now except apples" is natural. The URL picks whichever list is shorter —
  // ?plants= (a small include set, e.g. a guide link) or ?except= (a few hidden).
  const qs = new URLSearchParams(location.search);
  const csv = (v: string | null) => (v ? v.split(',').map((s) => s.trim()).filter(Boolean) : []);
  const plantsInclude = new Set<string>([...csv(qs.get('plants')), ...csv(qs.get('plant'))]);
  const plantsExclude = new Set<string>(csv(qs.get('except')));
  // Kept for the home embed (include-only preview).
  const plantsFilter = plantsInclude;
  const initialCats = new Set<string>(csv(qs.get('cat')));
  const initialRipe = qs.get('ripe') === '1';
  const hasDeepLink = plantsInclude.size > 0 || plantsExclude.size > 0 || initialCats.size > 0 || initialRipe;

  // Per-plant metadata (title, category list, ripe window) emitted at build to
  // dist/data/plants.json — joined onto every pin so the map can colour by the
  // plant's primary category, show the guide title as the pin name, filter by any
  // of a plant's categories, and compute "ripe now" against the real current date.
  let plantsMeta: Record<string, any> = {};
  async function loadPlantsMeta() {
    try { const r = await fetch('/data/plants.json?t=' + Date.now(), { cache: 'no-store' }); if (r.ok) return await r.json(); } catch {}
    return {};
  }
  // Is this plant in season TODAY? Mirrors src/lib/season.ts against the live date
  // (not the build date), so the badge stays truthful between nightly rebuilds.
  function isRipeNow(meta: any): boolean {
    if (!meta || !meta.ripeStart || !meta.ripeEnd) return false;
    const now = new Date();
    const md = (s: string) => { const [m, d] = s.split('-').map(Number); return new Date(now.getFullYear(), m - 1, d); };
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const a = md(meta.ripeStart), b = md(meta.ripeEnd);
    return b >= a ? today >= a && today <= b : today >= a || today <= b;
  }

  async function saveMove(id: number, marker: any, origin: any) {
    const token = ensureToken();
    if (!token) { marker.setLatLng(origin); flash('No token — move not saved.'); return; }
    const { lat, lng } = marker.getLatLng();
    flash('Saving…', true);
    try {
      const r = await fetch('/api/pins/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
        body: JSON.stringify({ lon: +lng.toFixed(6), lat: +lat.toFixed(6) }),
      });
      if (r.status === 401) { clearToken(); marker.setLatLng(origin); flash('Edit token rejected — moved back. Drag again to re-enter it.', true); return; }
      if (!r.ok) { const e = await r.json().catch(() => ({})); throw new Error(e.error || ('HTTP ' + r.status)); }
      flash('Saved ✓');
    } catch (err: any) {
      marker.setLatLng(origin);
      flash('Save failed (' + (err?.message || err) + ') — moved back.');
    }
  }

  // Long-press to move (mobile-safe). Pins are inert to touch by default so you
  // can pan the map freely; press-and-hold ~0.45s on a pin to "lift" it, then drag
  // and release to drop. Moving the finger before the hold completes is treated as
  // a pan and never grabs the pin — which was the old draggable-marker footgun.
  function enableLongPressMove(marker: any, id: number) {
    const ARM_MS = 450, SLOP = 10;
    // On touch the finger covers the pin, so while dragging we float the pin this
    // many px ABOVE the touch point — it stays visible and drops where it's shown.
    // Mouse has nothing obscuring the cursor, so no offset there.
    const TOUCH_LIFT_PX = 56;
    let timer: any = null, armed = false, start: any = null, originLL: any = null;

    const arm = () => {
      armed = true;
      originLL = marker.getLatLng();
      map.dragging.disable();               // don't pan while a pin is lifted
      marker.getElement()?.classList.add('pin-armed');
      try { (navigator as any).vibrate?.(30); } catch {}
      flash('Pin lifted — drag to move, release to drop.', true);
    };
    const disarm = () => {
      map.dragging.enable();
      marker.getElement()?.classList.remove('pin-armed');
    };
    const onMove = (e: any) => {
      if (!armed) {
        // A move before the hold completes = a pan/tap; abandon arming.
        if (start && Math.hypot(e.clientX - start.x, e.clientY - start.y) > SLOP) { clearTimeout(timer); cleanup(); }
        return;
      }
      e.preventDefault();
      const pt = map.mouseEventToContainerPoint(e);
      if (e.pointerType === 'touch') pt.y -= TOUCH_LIFT_PX; // lift the pin above the thumb
      marker.setLatLng(map.containerPointToLatLng(pt));
    };
    const onUp = (e: any) => {
      clearTimeout(timer);
      if (armed) {
        e.preventDefault?.();
        disarm();
        suppressNextClick(marker.getElement()); // don't pop the popup right after a move
        saveMove(id, marker, originLL);
      }
      cleanup();
    };
    const onCancel = () => {
      clearTimeout(timer);
      if (armed) { marker.setLatLng(originLL); disarm(); }
      cleanup();
    };
    const cleanup = () => {
      armed = false; start = null;
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      window.removeEventListener('pointercancel', onCancel);
    };
    const onDown = (e: any) => {
      if (!editMode) return; // handler is always attached; only arms while editing
      if (e.button != null && e.button > 0) return; // primary button / touch only
      start = { x: e.clientX, y: e.clientY };
      timer = setTimeout(arm, ARM_MS);
      window.addEventListener('pointermove', onMove, { passive: false });
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', onCancel);
    };
    marker.on('add', () => marker.getElement()?.addEventListener('pointerdown', onDown));
  }

  function suppressNextClick(el: any) {
    if (!el) return;
    const h = (ev: any) => { ev.stopPropagation(); ev.preventDefault(); el.removeEventListener('click', h, true); };
    el.addEventListener('click', h, true);
    setTimeout(() => el.removeEventListener('click', h, true), 500);
  }

  // Confirmed spots load live from the API; fall back to the build-time static
  // export if the service is down, so the map still renders. Leads are a static
  // export of the same DB (verified=0), so both share one feature shape.
  async function loadConfirmed() {
    try {
      const r = await fetch('/api/pins', { cache: 'no-store' });
      if (r.ok) return await r.json();
    } catch {}
    const r = await fetch('/data/foraging-spots.geojson?t=' + Date.now(), { cache: 'no-store' });
    return r.json();
  }
  async function loadLeads() {
    try {
      const r = await fetch('/data/pins-leads.geojson?t=' + Date.now(), { cache: 'no-store' });
      if (r.ok) return await r.json();
    } catch {}
    return { features: [] };
  }

  const isMapPage = document.querySelector('.map-wrap')?.classList.contains('full');

  // Home embed: confirmed spots only, plain teardrops + an inline legend. No panel,
  // no leads, no clustering — it's a small preview, not the working map.
  function initEmbed() {
    loadConfirmed().then((geo) => {
      const cats = new Set<string>();
      const markers: any[] = [];
      for (const f of geo.features || []) {
        const p = f.properties || {};
        if (plantsFilter.size && !plantsFilter.has(p.plant)) continue;
        const cat = p.category || 'other';
        cats.add(cat);
        const [lon, lat] = f.geometry.coordinates;
        const m = L.marker([lat, lon], { icon: pinIcon(CAT_COLORS[cat] || CAT_COLORS.other, p.caution) }).addTo(map);
        m.bindPopup(pinPopup(p, String(f.id), true), { maxWidth: 244, minWidth: 200, maxHeight: 300, autoPan: true, keepInView: true });
        markers.push(m);
      }
      try {
        const b = L.featureGroup(markers).getBounds();
        if (b.isValid()) { spotsBounds = b; if (!didLocate) map.fitBounds(b.pad(0.35)); }
      } catch {}
      setTimeout(() => map.invalidateSize(), 60);
      const legend = document.getElementById('legend');
      if (legend) legend.innerHTML = [...cats].sort((a, b) => CAT_ORDER.indexOf(a) - CAT_ORDER.indexOf(b))
        .map((c) => `<span><i class="dot" style="background:${CAT_COLORS[c] || CAT_COLORS.other}"></i>${esc(CAT_LABEL[c] || c)}</span>`).join('');
    }).catch((err) => {
      if (mapEl) mapEl.innerHTML = '<p style="padding:20px">Could not load map data.</p>';
      console.error(err);
    });
  }

  if (isMapPage) initFullMap(); else initEmbed();

  function loadPref(key: string, fallback: boolean) {
    try { const v = localStorage.getItem(key); return v === null ? fallback : v === '1'; }
    catch { return fallback; }
  }
  function savePref(key: string, on: boolean) {
    try { localStorage.setItem(key, on ? '1' : '0'); } catch {}
  }

  // One popup for every pin. `verified` confirmed spots show season/location/photos;
  // leads show their source + a link back to it. Both carry an edit-mode Delete
  // button, and leads a Promote button (CSS gates those on body.map-editing).
  // Category badge + a caution line are shown for both.
  function pinPopup(p: any, key: string, verified: boolean) {
    const cat = p.category || 'other';
    const src = p.source || (verified ? 'confirmed' : 'inat');
    const photos: string[] = verified && Array.isArray(p.photos) ? p.photos : [];
    const imgs = photos
      .map((f) => `<a href="/photos/spots/${seg(f)}" target="_blank" rel="noopener"><img src="/photos/spots/${seg(f)}" alt="${esc(p.name)}" loading="lazy" /></a>`)
      .join('');
    let prov = '';
    if (!verified) {
      if (src === 'fallingfruit') prov = '◆ Falling Fruit · community spot';
      else if (src === 'montreal') {
        const extra = [p.where && esc(p.where), p.planted && ('planted ' + esc(p.planted))].filter(Boolean).join(' · ');
        prov = '▲ Ville de Montréal · city tree' + (extra ? ' · ' + extra : '');
      } else prov = `🔍 iNaturalist${p.observed ? ' · ' + esc(p.observed) : ''}${p.observer ? ' · @' + esc(p.observer) : ''}${p.obscured ? ' · ⚠ location obscured' : ''}`;
    }
    const linkLabel = src === 'fallingfruit' ? 'View on Falling Fruit →' : src === 'montreal' ? 'City tree dataset →' : 'View on iNaturalist →';
    return (
      `<div class="p-pop">` +
        `<h3>${esc(p.name) || (verified ? 'Spot' : 'Lead')}</h3>` +
        (p.species ? `<div class="p-sci">${esc(p.species)}</div>` : '') +
        `<div class="p-cat"><i class="dot" style="background:${CAT_COLORS[cat] || CAT_COLORS.other}"></i>${esc(CAT_LABEL[cat] || cat)}</div>` +
        (p.caution ? `<div class="p-caution">⚠ Caution — has a dangerous lookalike; be certain before you eat.</div>` : '') +
        (p.notes ? `<div class="p-meta">${esc(p.notes)}</div>` : '') +
        (verified && p.season ? `<div class="p-meta">🗓 ${esc(p.season)}</div>` : '') +
        (verified && p.location ? `<div class="p-meta">📍 ${esc(p.location)}</div>` : '') +
        (prov ? `<div class="p-meta p-obs">${prov}</div>` : '') +
        imgs +
        (!verified && /^https?:\/\//i.test(p.sourceUrl || '') ? `<a class="p-guide" href="${esc(p.sourceUrl)}" target="_blank" rel="noopener">${linkLabel}</a>` : '') +
        (p.plant ? `<a class="p-guide" href="/plants/${seg(p.plant)}">View plant guide →</a>` : '') +
        (!verified ? `<button type="button" class="scout-promote" data-promote="${esc(key)}">➕ Promote to confirmed spot</button>` : '') +
        `<button type="button" class="scout-delete" data-delete="${esc(key)}">🗑 Delete this pin</button>` +
      `</div>`
    );
  }

  // Fullscreen working map: confirmed spots AND scouting leads flow through ONE
  // marker-cluster group. Colour = category, shape = provenance (teardrop confirmed
  // / circle iNat / diamond FF / triangle city), amber ring = caution. The panel
  // toggles each layer + filters by type; a promoted lead flips to a confirmed pin.
  function initFullMap() {
    const SOURCES: Record<string, any> = {
      inat: { label: 'iNaturalist', glyph: '●', tag: 'research-grade · unverified', attrib: '' },
      fallingfruit: { label: 'Falling Fruit', glyph: '◆', tag: 'community · CC BY-NC-SA',
        attrib: 'Community spots via <a href="https://fallingfruit.org" target="_blank" rel="noopener">Falling Fruit</a> (CC BY-NC-SA)' },
      montreal: { label: 'City trees', glyph: '▲', tag: 'city inventory · sample',
        attrib: 'Public-tree inventory © <a href="https://donnees.montreal.ca/dataset/arbres" target="_blank" rel="noopener">Ville de Montréal</a> (CC BY 4.0)' },
    };
    const SOURCE_ORDER = ['inat', 'fallingfruit', 'montreal'];

    const cluster = (L as any).markerClusterGroup({
      maxClusterRadius: 55,
      showCoverageOnHover: false,
      spiderfyOnMaxZoom: true,
      chunkedLoading: true,
      iconCreateFunction: (c: any) => {
        const n = c.getChildCount();
        const size = n < 10 ? 34 : n < 100 ? 40 : 48;
        return L.divIcon({ html: `<span>${n}</span>`, className: 'scout-cluster', iconSize: [size, size] });
      },
    });
    cluster.addTo(map);

    type Rec = { id: any; key: string; masterKey: string; verified: boolean; source: string;
      category: string; categories: string[]; caution: boolean; plant: string; title: string;
      ripe: boolean; marker: any; props: any; lat: number; lon: number };
    const records: Rec[] = [];
    const inCluster = new Set<string>();
    const presentSrc = new Set<string>();
    let hasConfirmed = false;

    const build = (geo: any, verified: boolean) => {
      for (const f of geo.features || []) {
        const p = f.properties || {};
        const plant = p.plant || '';
        // Build EVERY pin (not just deep-linked ones): the plant filter seeds from
        // ?plants but the full plant list stays available to add/remove in-panel.
        const source = p.source || (verified ? 'confirmed' : 'inat');
        // Join the plant guide: title becomes the pin's display name, its category
        // list drives colour (primary) + the type filter, and its ripe window the
        // "ripe now" filter. Guideless leads fall back to their own species/category.
        const meta = plantsMeta[plant];
        const categories: string[] = meta?.categories?.length ? meta.categories : [p.category || 'other'];
        const category = categories[0];
        const title = meta?.title || p.name || (verified ? 'Spot' : 'Lead');
        const ripe = isRipeNow(meta);
        const caution = !!p.caution;
        const [lon, lat] = f.geometry.coordinates;
        const key = String(f.id);
        const masterKey = verified ? 'confirmed' : source;
        const props = { ...p, name: title };   // popup shows the plant's title, not a custom name
        const icon = verified
          ? pinIcon(CAT_COLORS[category] || CAT_COLORS.other, caution)
          : leadIcon(SOURCE_SHAPE[source] || 'circle', CAT_COLORS[category] || CAT_COLORS.other, caution);
        const marker = L.marker([lat, lon], { icon })
          .bindPopup(pinPopup(props, key, verified), { maxWidth: 244, minWidth: 200, maxHeight: 300, autoPan: true, keepInView: true });
        if (verified && typeof f.id === 'number') enableLongPressMove(marker, f.id as number);
        records.push({ id: f.id, key, masterKey, verified, source, category, categories, caution, plant, title, ripe, marker, props, lat, lon });
        if (verified) hasConfirmed = true; else presentSrc.add(source);
      }
    };

    Promise.all([loadConfirmed(), loadLeads(), loadPlantsMeta()]).then(([confirmed, leads, meta]) => {
      // The persistent #edit-banner (applyEditState) shows the edit hint; no flash here.
      plantsMeta = meta || {};
      build(confirmed, true);
      build(leads, false);

      // Every distinct plant present (the guideless tail has no plant → not listed;
      // those pins bypass the plant filter). `state.plants` is the SHOWN set: all by
      // default (exclude-by-default), narrowed by a ?plants include or an ?except
      // exclude deep-link.
      const allPlantSlugs = [...new Set(records.map((r) => r.plant).filter(Boolean))];
      const initialShown = plantsInclude.size
        ? new Set([...plantsInclude].filter((s) => allPlantSlugs.includes(s)))
        : new Set(allPlantSlugs.filter((s) => !plantsExclude.has(s)));
      const narrowed = plantsInclude.size > 0 || plantsExclude.size > 0;

      // Fit to the confirmed spots (or the deep-linked plants' pins) on first load.
      try {
        const forBounds = records
          .filter((r) => narrowed ? (!!r.plant && initialShown.has(r.plant)) : r.verified)
          .map((r) => [r.lat, r.lon]);
        if (forBounds.length) { spotsBounds = L.latLngBounds(forBounds as any); if (!didLocate) map.fitBounds(spotsBounds.pad(0.35)); }
      } catch {}
      setTimeout(() => map.invalidateSize(), 60);

      const div = panelScoutEl;
      if (!div) return;
      div.hidden = false;

      // Filter state. Layers: My spots default ON, leads default OFF — but any
      // deep-link (plants/except/cat/ripe) forces every source ON so the linked pins
      // actually surface. Category defaults from ?cat (else all on). `plants` is the
      // SHOWN plant set; `ripeNow` narrows to what's in season today.
      const state = {
        master: {} as Record<string, boolean>,
        cat: {} as Record<string, boolean>,
        caution: true,
        plants: initialShown,
        ripeNow: initialRipe,
      };
      state.master.confirmed = hasDeepLink ? true : loadPref('layer.confirmed', true);
      for (const s of SOURCE_ORDER) state.master[s] = hasDeepLink ? true : loadPref('scout.on.' + s, false);
      for (const c of CAT_ORDER) state.cat[c] = initialCats.size ? initialCats.has(c) : loadPref('filter.cat.' + c, true);
      state.caution = loadPref('filter.caution', true);

      // A record shows when its layer is on, at least one of its (plant) categories is
      // enabled, caution allows it, its plant is in the shown set (guideless pins with
      // no plant bypass this), and it's ripe now (if that filter is on).
      const visible = (r: Rec) =>
        state.master[r.masterKey] &&
        r.categories.some((c) => state.cat[c] !== false) &&
        (state.caution || !r.caution) &&
        (!r.plant || state.plants.has(r.plant)) &&
        (!state.ripeNow || r.ripe);

      // Reflect the active filters into the URL (shareable/bookmarkable) without
      // reloading. For plants, write whichever list is shorter: ?plants= (only these)
      // or ?except= (all but these); nothing when all are shown.
      const syncURL = () => {
        const u = new URL(location.href);
        const set = (k: string, v: string) => v ? u.searchParams.set(k, v) : u.searchParams.delete(k);
        const shown = allPlantSlugs.filter((s) => state.plants.has(s));
        const hidden = allPlantSlugs.filter((s) => !state.plants.has(s));
        u.searchParams.delete('plant');   // fold the legacy alias in
        if (!hidden.length) { u.searchParams.delete('plants'); u.searchParams.delete('except'); }
        else if (shown.length <= hidden.length) { set('plants', shown.join(',')); u.searchParams.delete('except'); }
        else { set('except', hidden.join(',')); u.searchParams.delete('plants'); }
        set('ripe', state.ripeNow ? '1' : '');
        const offCats = CAT_ORDER.filter((c) => records.some((r) => r.categories.includes(c)) && state.cat[c] === false);
        set('cat', offCats.length ? CAT_ORDER.filter((c) => state.cat[c] !== false && records.some((r) => r.categories.includes(c))).join(',') : '');
        history.replaceState(null, '', u);
      };

      const apply = () => {
        const add: any[] = [], remove: any[] = [];
        for (const r of records) {
          const show = visible(r);
          if (show && !inCluster.has(r.key)) { add.push(r.marker); inCluster.add(r.key); }
          else if (!show && inCluster.has(r.key)) { remove.push(r.marker); inCluster.delete(r.key); }
        }
        if (remove.length) cluster.removeLayers(remove);
        if (add.length) cluster.addLayers(add);
      };
      apply();

      let renderCtl = () => {};

      // Delete a pin (edit mode). Confirmed spots are removed outright; leads are
      // tombstoned server-side so a re-scout won't resurrect them. Either way the
      // marker + record are dropped in place, no reload.
      const deletePinAt = async (key: string, btn: HTMLButtonElement) => {
        const i = records.findIndex((x) => x.key === key);
        if (i < 0) return;
        const r = records[i];
        if (!window.confirm(`Delete "${r.props.name || (r.verified ? 'this spot' : 'this lead')}"? This can't be undone.`)) return;
        const token = ensureToken();
        if (!token) { flash('No token — pin not deleted.'); return; }
        btn.disabled = true; btn.textContent = 'Deleting…';
        try {
          const resp = await fetch('/api/pins/' + r.id, {
            method: 'DELETE',
            headers: { Authorization: 'Bearer ' + token },
          });
          if (resp.status === 401) { clearToken(); flash('Edit token rejected — try again to re-enter it.', true); btn.disabled = false; btn.textContent = '🗑 Delete this pin'; return; }
          if (!resp.ok) { const e = await resp.json().catch(() => ({})); throw new Error(e.error || ('HTTP ' + resp.status)); }
          map.closePopup();
          if (inCluster.has(r.key)) { cluster.removeLayer(r.marker); inCluster.delete(r.key); }
          records.splice(i, 1);
          renderCtl();
          flash('Deleted ✓');
        } catch (err: any) {
          flash('Delete failed (' + (err?.message || err) + ').');
          btn.disabled = false; btn.textContent = '🗑 Delete this pin';
        }
      };

      // Promote a lead → a confirmed spot in ONE click: a lead already carries a
      // curated category, so there's nothing to pick. Tapping ➕ POSTs straight to
      // /api/pins/:id/promote (flips verified=1, keeps provenance so a re-scout
      // won't resurrect it) and we swap the marker to a teardrop in place.
      const promoteLead = async (key: string, btn: HTMLButtonElement) => {
        const r = records.find((x) => x.key === key);
        if (!r) return;
        const token = ensureToken();
        if (!token) { flash('No token — spot not created.'); return; }
        btn.disabled = true; btn.textContent = 'Promoting…';
        const reset = () => { btn.disabled = false; btn.textContent = '➕ Promote to confirmed spot'; };
        try {
          const resp = await fetch('/api/pins/' + r.id + '/promote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ category: r.category, plant: r.props.plant ?? null }),
          });
          if (resp.status === 401) { clearToken(); flash('Edit token rejected — try again to re-enter it.', true); reset(); return; }
          if (!resp.ok) { const e = await resp.json().catch(() => ({})); throw new Error(e.error || ('HTTP ' + resp.status)); }
          const { spot } = await resp.json();
          map.closePopup();
          // Convert the record in place: same marker slot, now a confirmed teardrop.
          if (inCluster.has(r.key)) { cluster.removeLayer(r.marker); inCluster.delete(r.key); }
          r.verified = true; r.masterKey = 'confirmed';
          r.props = { ...r.props, ...spot, verified: true };
          r.marker = L.marker([r.lat, r.lon], { icon: pinIcon(CAT_COLORS[r.category] || CAT_COLORS.other, r.caution) })
            .bindPopup(pinPopup(r.props, r.key, true), { maxWidth: 244, minWidth: 200, maxHeight: 300, autoPan: true, keepInView: true });
          if (typeof r.id === 'number') enableLongPressMove(r.marker, r.id);
          hasConfirmed = true;
          apply();
          renderCtl();
          flash('Promoted ✓ — now a confirmed spot.');
        } catch (err: any) {
          flash('Promote failed (' + (err?.message || err) + ').');
          reset();
        }
      };

      map.on('popupopen', (e: any) => {
        const el = e.popup.getElement();
        if (!el) return;
        L.DomEvent.disableClickPropagation(el);
        const db = el.querySelector('.scout-delete') as HTMLButtonElement | null;
        if (db) db.addEventListener('click', () => deletePinAt(String(db.dataset.delete), db), { once: true });
        const pb = el.querySelector('.scout-promote') as HTMLButtonElement | null;
        if (pb) pb.addEventListener('click', () => promoteLead(String(pb.dataset.promote), pb), { once: true });
      });

      const layerCount = (mk: string) => records.filter((r) => r.masterKey === mk).length;
      const okCaution = (r: Rec) => state.caution || !r.caution;
      const catCount = (c: string) => records.filter((r) => r.categories.includes(c) && okCaution(r)).length;
      const cautionCount = () => records.filter((r) => r.caution).length;
      const ripeCount = () => records.filter((r) => r.ripe && okCaution(r)).length;
      const catsShown = () => CAT_ORDER.filter((c) => records.some((r) => r.categories.includes(c)));
      const srcShown = SOURCE_ORDER.filter((s) => presentSrc.has(s));
      // Distinct plants present (guideless tail excluded — nothing to name it by).
      const plantsShown = () => {
        const agg: Record<string, { slug: string; title: string; count: number }> = {};
        for (const r of records) { if (!r.plant) continue; (agg[r.plant] ||= { slug: r.plant, title: r.title, count: 0 }).count++; }
        return Object.values(agg).sort((a, b) => a.title.localeCompare(b.title));
      };
      let plantSearch = '';

      // Filter the rendered plant rows by the search box without a full re-render
      // (keeps input focus). Matches on the plant title.
      const applyPlantSearch = () => {
        const q = plantSearch.trim().toLowerCase();
        div.querySelectorAll('.plant-opt').forEach((el) => {
          const name = (el as HTMLElement).dataset.name || '';
          (el as HTMLElement).style.display = !q || name.includes(q) ? '' : 'none';
        });
      };

      renderCtl = () => {
        const layerRow = (mk: string, glyph: string, label: string, tag: string, on: boolean) =>
          `<label class="scout-master"><input type="checkbox" data-master="${mk}"${on ? ' checked' : ''}>` +
          `<span class="scout-src"><b>${glyph} ${label}</b><em>${tag} · ${layerCount(mk)}</em></span></label>`;
        const pls = plantsShown();
        div.innerHTML =
          `<h4 class="panel-h">Map pins <em>colour = type · ⚠ = lookalike</em></h4>` +
          (hasConfirmed ? layerRow('confirmed', '📍', 'My spots', 'confirmed', state.master.confirmed) : '') +
          srcShown.map((s) => layerRow(s, SOURCES[s].glyph, SOURCES[s].label, SOURCES[s].tag, state.master[s])).join('') +
          `<div class="scout-tiers">` +
            `<label class="scout-tier scout-ripe"><input type="checkbox" data-ripe${state.ripeNow ? ' checked' : ''}>` +
              `<i class="dot" style="background:#2f7d4f"></i>🟢 Ripe now <b>${ripeCount()}</b></label>` +
            `<div class="scout-tiers-h">Filter by type</div>` +
            catsShown().map((c) =>
              `<label class="scout-tier"><input type="checkbox" data-cat="${c}"${state.cat[c] !== false ? ' checked' : ''}>` +
              `<i class="dot" style="background:${CAT_COLORS[c]}"></i>${CAT_LABEL[c]} <b>${catCount(c)}</b></label>`).join('') +
            (cautionCount() ? `<label class="scout-tier scout-caution"><input type="checkbox" data-caution${state.caution ? ' checked' : ''}>` +
              `<i class="dot" style="background:${CAUTION_COLOR}"></i>⚠ Caution — lookalikes <b>${cautionCount()}</b></label>` : '') +
          `</div>` +
          (pls.length ? `<div class="scout-plants">` +
            `<div class="scout-tiers-h">Filter by plant` +
              `<span class="plant-acts"><a class="plant-all" href="#">all</a><a class="plant-none" href="#">none</a></span></div>` +
            `<input type="search" class="plant-search" placeholder="Search plants…" value="${esc(plantSearch)}" autocomplete="off">` +
            `<div class="plant-list">` +
              pls.map((pl) =>
                `<label class="plant-opt" data-name="${esc(pl.title.toLowerCase())}"><input type="checkbox" data-plant="${esc(pl.slug)}"${state.plants.has(pl.slug) ? ' checked' : ''}>` +
                `<span>${esc(pl.title)}</span><b>${pl.count}</b></label>`).join('') +
            `</div>` +
          `</div>` : '') +
          srcShown.filter((s) => SOURCES[s].attrib).map((s) => `<p class="scout-attrib">${SOURCES[s].attrib}</p>`).join('');

        div.querySelectorAll('input[data-master]').forEach((el) => el.addEventListener('change', () => {
          const k = (el as HTMLInputElement).dataset.master as string;
          state.master[k] = (el as HTMLInputElement).checked;
          savePref(k === 'confirmed' ? 'layer.confirmed' : 'scout.on.' + k, state.master[k]);
          apply();
        }));
        div.querySelectorAll('input[data-cat]').forEach((el) => el.addEventListener('change', () => {
          const c = (el as HTMLInputElement).dataset.cat as string;
          state.cat[c] = (el as HTMLInputElement).checked;
          savePref('filter.cat.' + c, state.cat[c]);
          apply(); syncURL();
        }));
        const rp = div.querySelector('input[data-ripe]');
        if (rp) rp.addEventListener('change', () => {
          state.ripeNow = (rp as HTMLInputElement).checked;
          apply(); syncURL();
        });
        const cb = div.querySelector('input[data-caution]');
        if (cb) cb.addEventListener('change', () => {
          state.caution = (cb as HTMLInputElement).checked;
          savePref('filter.caution', state.caution);
          apply(); renderCtl();
        });
        div.querySelectorAll('input[data-plant]').forEach((el) => el.addEventListener('change', () => {
          const slug = (el as HTMLInputElement).dataset.plant as string;
          if ((el as HTMLInputElement).checked) state.plants.add(slug); else state.plants.delete(slug);
          apply(); syncURL();
        }));
        // Bulk-select conveniences: all = show every plant (clears the filter/param),
        // none = hide all (then check a few for an include filter). Both keep the
        // search box's current text/scroll.
        const setAllPlants = (on: boolean) => {
          state.plants = new Set(on ? plantsShown().map((p) => p.slug) : []);
          div.querySelectorAll('input[data-plant]').forEach((c) => { (c as HTMLInputElement).checked = on; });
          apply(); syncURL();
        };
        div.querySelector('.plant-all')?.addEventListener('click', (e) => { e.preventDefault(); setAllPlants(true); });
        div.querySelector('.plant-none')?.addEventListener('click', (e) => { e.preventDefault(); setAllPlants(false); });
        const search = div.querySelector('.plant-search') as HTMLInputElement | null;
        if (search) search.addEventListener('input', () => { plantSearch = search.value; applyPlantSearch(); });
        applyPlantSearch();
      };
      renderCtl();

      // A contributor's freshly-saved spot drops straight into the live cluster
      // (no reload) as a confirmed teardrop, with the same popup + admin move/
      // delete wiring as any other confirmed pin. It joins the plant guide just like
      // a loaded pin (categories/title/ripe) so the new filters see it. Force "My
      // spots" on so it shows.
      onSpotAdded = (spot: any) => {
        const plant = spot.plant || '';
        const meta = plantsMeta[plant];
        const categories: string[] = meta?.categories?.length ? meta.categories : [spot.category || 'other'];
        const category = categories[0];
        const caution = !!spot.caution;
        const title = meta?.title || spot.name || 'Spot';
        const ripe = isRipeNow(meta);
        const key = String(spot.id);
        const props = { ...spot, name: title };
        const marker = L.marker([spot.lat, spot.lon], { icon: pinIcon(CAT_COLORS[category] || CAT_COLORS.other, caution) })
          .bindPopup(pinPopup(props, key, true), { maxWidth: 244, minWidth: 200, maxHeight: 300, autoPan: true, keepInView: true });
        if (typeof spot.id === 'number') enableLongPressMove(marker, spot.id);
        records.push({ id: spot.id, key, masterKey: 'confirmed', verified: true, source: 'confirmed',
          category, categories, caution, plant, title, ripe, marker, props, lat: spot.lat, lon: spot.lon });
        hasConfirmed = true;
        if (!state.master.confirmed) { state.master.confirmed = true; savePref('layer.confirmed', true); }
        if (!state.cat[category]) { state.cat[category] = true; savePref('filter.cat.' + category, true); }
        if (plant) state.plants.add(plant);   // ensure the fresh pin passes the plant filter
        apply(); renderCtl();
        // Zoom/decluster so the fresh pin is individually visible, THEN pop it —
        // openPopup on a still-clustered marker is a no-op.
        map.setView([spot.lat, spot.lon], Math.max(map.getZoom(), 16), { animate: true });
        try { cluster.zoomToShowLayer(marker, () => marker.openPopup()); }
        catch { marker.openPopup(); }
      };
    }).catch((err) => {
      if (mapEl) mapEl.innerHTML = '<p style="padding:20px">Could not load map data.</p>';
      console.error(err);
    });
  }

  // ── Contribute: add a spot ────────────────────────────────────────────────
  // The ➕ opens a bottom sheet over a still-live map. A fixed crosshair marks
  // where the pin will land; the visitor PANS the map under it to position (the
  // one place-a-pin affordance normal users get — the admin drag-move stays
  // admin-only). Placement precedence: a geotagged photo > "use my location" >
  // wherever they leave the crosshair. Picking the plant inherits its name/
  // category/species; an escape hatch covers finds with no guide yet.
  const PLANT_CATALOG: { slug: string; title: string; category: string; species: string }[] = (() => {
    try { return JSON.parse(document.getElementById('plant-catalog')?.textContent || '[]'); } catch { return []; }
  })();

  let addMode = false;
  let addSheet: HTMLElement | null = null;
  let addCross: HTMLElement | null = null;
  let addPhotoFiles: File[] = [];
  let addBusy = false;
  const OTHER = '__other__'; // sentinel <option> value for a not-in-the-guide find

  const byId = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;

  // The crosshair's centre as a pixel point in the map container.
  function crosshairPoint() {
    const mr = mapEl!.getBoundingClientRect();
    const cr = addCross!.getBoundingClientRect();
    return L.point(cr.left + cr.width / 2 - mr.left, cr.top + cr.height / 2 - mr.top);
  }
  // The lat/lng under the crosshair's centre, in the map's current view.
  function crosshairLatLng() {
    return map.containerPointToLatLng(crosshairPoint());
  }
  // Recenter so a given lat/lng lands UNDER the crosshair (not the map centre —
  // the crosshair sits high, above the sheet). Used by "use my location" and open.
  function centerCrosshairOn(lat: number, lon: number, minZoom: number) {
    const z = Math.max(map.getZoom(), minZoom);
    const target = map.project([lat, lon], z).subtract(crosshairPoint()).add(map.getSize().divideBy(2));
    map.setView(map.unproject(target, z), z, { animate: true });
  }
  // Keep the crosshair centred in the map area ABOVE the sheet (thumb covers the
  // sheet, eyes on the pin). Recomputed on open and on resize.
  function positionCross() {
    if (!addCross || !addSheet) return;
    addCross.style.top = Math.max(64, addSheet.offsetTop / 2) + 'px';
  }
  const setLocText = (t: string) => { const el = byId('add-loc-txt'); if (el) el.textContent = t; };

  function endAddMode() {
    addMode = false; addBusy = false; addPhotoFiles = [];
    document.body.classList.remove('map-adding');
    addSheet?.remove(); addSheet = null;
    addCross?.remove(); addCross = null;
    clearFlash();
  }

  // The <select> value is a plant slug, the OTHER sentinel, or '' (placeholder).
  const isOther = () => byId<HTMLSelectElement>('add-plant')?.value === OTHER;
  // Resolve the selected slug to a guide plant, or null for a not-in-the-guide find.
  function resolvePlant() {
    const v = byId<HTMLSelectElement>('add-plant')?.value || '';
    if (!v || v === OTHER) return null;
    return PLANT_CATALOG.find((p) => p.slug === v) || null;
  }
  function addValid(): boolean {
    // A guide plant chosen, or "other" with a typed name. Category isn't asked for —
    // it's the plant's (guide) or `other` for a custom find.
    if (isOther()) return !!(byId<HTMLInputElement>('add-plant-other')?.value || '').trim();
    return !!resolvePlant();
  }
  function refreshSave() { const b = byId<HTMLButtonElement>('add-save'); if (b) b.disabled = !addValid() || addBusy; }

  // File.type is empty for some iOS HEIC picks — infer a content-type from the
  // extension so the upload carries one (the server converts HEIC → JPEG).
  function photoTypeFromName(nm: string): string {
    const ext = (nm.split('.').pop() || '').toLowerCase();
    return ({ jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp',
      heic: 'image/heic', heif: 'image/heif' } as Record<string, string>)[ext] || 'application/octet-stream';
  }

  async function handlePhoto(input: HTMLInputElement) {
    addPhotoFiles = input.files ? Array.from(input.files) : [];
    const prev = byId('add-photo-prev');
    if (!addPhotoFiles.length) { if (prev) { prev.hidden = true; prev.innerHTML = ''; } return; }
    // HEIC won't render in an <img> on most browsers, so only preview types the
    // browser can draw; either way the server stores a JPEG. One thumbnail per pick.
    if (prev) {
      prev.hidden = false;
      prev.innerHTML = addPhotoFiles.map((f) =>
        /image\/(jpeg|png|webp|gif)/i.test(f.type)
          ? `<img src="${URL.createObjectURL(f)}" alt="">`
          : `<div class="add-photo-note">📷 ${esc(f.name)}</div>`
      ).join('');
    }
    try {
      // Auto-place from the first geotagged photo. EXIF read is JPEG-only; HEIC/other
      // fall back to device GPS + manual pan.
      for (const f of addPhotoFiles) {
        const gps = await readExifGps(f);
        if (gps) {
          map.setView([gps.lat, gps.lon], Math.max(map.getZoom(), 17), { animate: true });
          setLocText('Placed from the photo’s location — pan to fine-tune.');
          flash('📷 Placed from the photo’s location.');
          break;
        }
      }
    } catch {}
  }

  async function doSave(btn: HTMLButtonElement) {
    if (addBusy || !addValid()) return;
    const user = getUser();
    if (!user) { flash('A name is needed to save your spot.'); return; }
    addBusy = true; btn.disabled = true;
    try {
      const ll = crosshairLatLng();
      const meta = resolvePlant();
      let name: string, category: string, species: string | null = null, plant: string | null = null;
      if (meta) {
        // Known plant → inherit name/category/species from the guide.
        name = meta.title; category = meta.category; species = meta.species || null; plant = meta.slug;
      } else {
        // Not-in-the-guide find → typed name, always the `other` category (category is
        // a property of the plant, not the pin; an unlisted plant is "other").
        name = byId<HTMLInputElement>('add-plant-other')!.value.trim();
        category = 'other';
      }
      const notes = byId<HTMLTextAreaElement>('add-notes')!.value.trim() || null;

      let photos: string[] = [];
      for (let i = 0; i < addPhotoFiles.length; i++) {
        const pf = addPhotoFiles[i];
        btn.textContent = addPhotoFiles.length > 1
          ? `Uploading photo ${i + 1}/${addPhotoFiles.length}…` : 'Uploading photo…';
        // iOS HEIC sometimes reports an empty File.type — infer from the name so the
        // server gets a real content-type (it converts HEIC → JPEG on receipt).
        const ct = pf.type || photoTypeFromName(pf.name);
        const up = await fetch('/api/photos?name=' + encodeURIComponent(user.name), {
          method: 'POST', headers: { 'Content-Type': ct }, body: pf,
        });
        if (!up.ok) { const e = await up.json().catch(() => ({})); throw new Error(e.error || ('photo upload failed (HTTP ' + up.status + ')')); }
        const { file } = await up.json();
        if (file) photos.push(file);
      }

      btn.textContent = 'Saving…';
      const r = await fetch('/api/pins', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name, category, species, notes, plant, photos,
          lon: +ll.lng.toFixed(6), lat: +ll.lat.toFixed(6), actor: user,
        }),
      });
      if (!r.ok) { const e = await r.json().catch(() => ({})); throw new Error(e.error || ('HTTP ' + r.status)); }
      const { spot } = await r.json();
      endAddMode();
      onSpotAdded(spot);
      flash('Added ✓ — thanks for the spot!');
    } catch (err: any) {
      flash('Couldn’t save (' + (err?.message || err) + ').');
      addBusy = false; btn.disabled = false; btn.textContent = 'Save spot';
    }
  }

  function buildAddUI() {
    const shell = (mapEl!.parentElement || mapEl) as HTMLElement;

    addCross = document.createElement('div');
    addCross.className = 'add-cross'; addCross.setAttribute('aria-hidden', 'true');
    addCross.innerHTML =
      `<svg viewBox="0 0 44 44" width="44" height="44">` +
        `<circle cx="22" cy="22" r="13" fill="none" stroke="#fff" stroke-width="3"/>` +
        `<circle cx="22" cy="22" r="13" fill="none" stroke="#21492b" stroke-width="1.6"/>` +
        `<circle cx="22" cy="22" r="2.6" fill="#21492b"/>` +
        `<path d="M22 3v7M22 34v7M3 22h7M34 22h7" stroke="#21492b" stroke-width="2" stroke-linecap="round"/></svg>`;
    shell.appendChild(addCross);

    // Plain native <select> — the most reliable picker on every phone (iOS shows its
    // wheel, Android its dropdown). Option values are plant SLUGS; a trailing "not in
    // the guide" sentinel reveals a free-text name (which lands in the `other` category).
    const opts = `<option value="" disabled selected>Choose what you found…</option>` +
      PLANT_CATALOG.map((p) => `<option value="${esc(p.slug)}">${esc(p.title)}</option>`).join('') +
      `<option value="${OTHER}">Something else — not in the guide</option>`;
    addSheet = document.createElement('div');
    addSheet.className = 'add-sheet';
    addSheet.innerHTML =
      `<div class="add-head"><strong>Add a foraging spot</strong>` +
        `<button type="button" class="add-x" aria-label="Cancel">✕</button></div>` +
      `<div class="add-loc"><span class="add-loc-txt" id="add-loc-txt">Pan the map so the crosshair sits on the spot.</span>` +
        `<button type="button" class="add-useloc">📍 Use my location</button></div>` +
      `<label class="add-row"><span>What did you find?</span>` +
        `<select class="add-plant" id="add-plant">${opts}</select></label>` +
      `<label class="add-row" id="add-other" hidden><span>Name your find</span>` +
        `<input type="text" id="add-plant-other" autocomplete="off" maxlength="80" ` +
          `placeholder="e.g. Wild grapes"></label>` +
      `<label class="add-row"><span>Photos <em>(optional)</em></span>` +
        `<input type="file" accept="image/*" id="add-photo" multiple></label>` +
      `<div class="add-photo-prev" id="add-photo-prev" hidden></div>` +
      `<label class="add-row"><span>Access notes <em>(optional)</em></span>` +
        `<textarea id="add-notes" rows="2" maxlength="500" placeholder="How to get to it — e.g. behind the big tree"></textarea></label>` +
      `<div class="add-actions"><button type="button" class="add-cancel">Cancel</button>` +
        `<button type="button" class="add-save" id="add-save" disabled>Save spot</button></div>`;
    shell.appendChild(addSheet);
    // The sheet owns its own gestures — don't let scrolling it pan/zoom the map.
    L.DomEvent.disableClickPropagation(addSheet);
    L.DomEvent.disableScrollPropagation(addSheet);

    addSheet.querySelector('.add-x')!.addEventListener('click', endAddMode);
    addSheet.querySelector('.add-cancel')!.addEventListener('click', endAddMode);
    addSheet.querySelector('.add-useloc')!.addEventListener('click', () => { setLocText('Locating…'); locateNow(); });
    const plantSel = byId<HTMLSelectElement>('add-plant')!;
    const otherRow = byId('add-other')!;
    const otherInput = byId<HTMLInputElement>('add-plant-other')!;
    const syncPlant = () => {
      const other = plantSel.value === OTHER;
      otherRow.hidden = !other; // "not in the guide" → reveal a free-text name field
      if (other) otherInput.focus();
      refreshSave();
    };
    plantSel.addEventListener('change', syncPlant);
    otherInput.addEventListener('input', refreshSave);
    byId<HTMLInputElement>('add-photo')!.addEventListener('change', (e) => handlePhoto(e.target as HTMLInputElement));
    byId<HTMLButtonElement>('add-save')!.addEventListener('click', (e) => doSave(e.currentTarget as HTMLButtonElement));

    positionCross();
  }

  function startAddMode() {
    if (addMode) return;
    const user = ensureUser();
    if (!user) { flash('Add cancelled — a name is needed to attribute your spot.'); return; }
    if (editMode) setEditMode(false); // adding and admin-editing are separate modes
    addMode = true;
    document.body.classList.add('map-adding');
    buildAddUI();
    // Default the crosshair to the user's location so field contributors barely
    // move it; if we have no fix yet, ask for one (recenters when it lands).
    if (userMarker) { const ll = userMarker.getLatLng(); centerCrosshairOn(ll.lat, ll.lng, 16); }
    else locateNow();
  }

  // Minimal client-side EXIF GPS reader (JPEG only) — best-effort, any failure
  // just means "no auto-place". Scans the APP1/Exif segment, walks IFD0 → GPS IFD,
  // and converts the deg/min/sec rationals (with N/S/E/W refs) to a decimal fix.
  async function readExifGps(file: File): Promise<{ lat: number; lon: number } | null> {
    try {
      if (!/jpe?g/i.test(file.type) && !/\.jpe?g$/i.test(file.name)) return null;
      const view = new DataView(await file.slice(0, 512 * 1024).arrayBuffer());
      const end = view.byteLength;
      if (view.getUint16(0) !== 0xffd8) return null; // not a JPEG
      let off = 2, tiff = -1;
      while (off < end - 4) {
        if (view.getUint8(off) !== 0xff) { off++; continue; }
        const marker = view.getUint8(off + 1);
        if (marker === 0xe1 && view.getUint32(off + 4) === 0x45786966) { tiff = off + 10; break; } // "Exif"
        if (marker === 0xd8 || marker === 0xd9 || (marker >= 0xd0 && marker <= 0xd7)) { off += 2; continue; }
        off += 2 + view.getUint16(off + 2);
      }
      if (tiff < 0 || tiff + 8 > end) return null;
      const le = view.getUint16(tiff) === 0x4949; // 'II' = little-endian
      const u16 = (a: number) => view.getUint16(a, le);
      const u32 = (a: number) => view.getUint32(a, le);
      const ifd0 = tiff + u32(tiff + 4);
      if (ifd0 + 2 > end) return null;
      let gpsRel = 0;
      const n0 = u16(ifd0);
      for (let i = 0; i < n0; i++) {
        const e = ifd0 + 2 + i * 12;
        if (e + 12 > end) break;
        if (u16(e) === 0x8825) { gpsRel = u32(e + 8); break; } // GPS IFD pointer
      }
      if (!gpsRel) return null;
      const gps = tiff + gpsRel;
      if (gps + 2 > end) return null;
      const ent: Record<number, number> = {};
      const gn = u16(gps);
      for (let i = 0; i < gn; i++) {
        const e = gps + 2 + i * 12;
        if (e + 12 > end) break;
        ent[u16(e)] = e;
      }
      const rat = (a: number) => { const d = u32(a + 4); return d ? u32(a) / d : 0; };
      const coord = (tag: number) => {
        const e = ent[tag]; if (e == null || u32(e + 4) < 3) return null;
        const b = tiff + u32(e + 8);
        if (b + 24 > end) return null;
        return rat(b) + rat(b + 8) / 60 + rat(b + 16) / 3600;
      };
      const ref = (tag: number) => { const e = ent[tag]; return e == null ? '' : String.fromCharCode(view.getUint8(e + 8)); };
      let lat = coord(2), lon = coord(4);
      if (lat == null || lon == null) return null;
      if (ref(1) === 'S') lat = -lat;
      if (ref(3) === 'W') lon = -lon;
      if (!isFinite(lat) || !isFinite(lon)) return null;
      if (Math.abs(lat) < 1e-6 && Math.abs(lon) < 1e-6) return null; // 0,0 = junk
      if (Math.abs(lat) > 90 || Math.abs(lon) > 180) return null;
      return { lat, lon };
    } catch { return null; }
  }

  window.addEventListener('resize', () => { map.invalidateSize(); if (addMode) positionCross(); });
  void isTouch;
</script>
