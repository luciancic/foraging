---
// Client-side Leaflet map. Pins load live from the /api/pins data API (the SQLite
// DB is the source of truth), falling back to the build-time static export at
// /data/foraging-spots.geojson if the API is unreachable.
// `fullscreen` makes the map fill the viewport below the header (map page);
// otherwise it's a boxed embed (home page).
interface Props { fullscreen?: boolean; }
const { fullscreen = false } = Astro.props;
---
<div class={`map-wrap${fullscreen ? ' full' : ''}`}>
  <div class="map-shell"><div id="map"></div></div>
  <div class="map-filter" id="map-filter" hidden></div>
  <div class="legend" id="legend"></div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" crossorigin="" />

<script>
  import L from 'leaflet';
  import 'leaflet.markercluster';

  const CAT_COLORS: Record<string, string> = {
    tree: '#6b8e23', berries: '#8a2f4a', greens: '#2f7d4f', herbs: '#4a8f7b',
    nuts: '#8a6d3b', mushrooms: '#9c6b4a', other: '#7a7a7a',
  };

  // Scouting layer (unverified iNaturalist leads) — a separate class from the
  // verified teardrop pins. Rendered as tier-coloured circles so the two never
  // read as the same thing. Tier = how to approach a find.
  const TIER_COLORS: Record<string, string> = {
    snack: '#2f7d4f', prep: '#b8791f', caution: '#c2571f', avoid: '#9a2b1e',
  };
  const TIER_LABEL: Record<string, string> = {
    snack: 'Snackable', prep: 'Needs prep', caution: 'Caution — lookalike', avoid: 'Toxic — avoid',
  };
  const TIER_ORDER = ['snack', 'prep', 'caution', 'avoid'];

  // Promoting a scouting lead → a confirmed spot (POST /api/pins) needs a
  // `category` (the verified-pin vocabulary); leads only carry a `tier`, so we
  // guess a sensible default from the name/species and let the picker override.
  const CATEGORIES = ['tree', 'berries', 'greens', 'herbs', 'nuts', 'mushrooms', 'other'];
  const SRC_LABEL: Record<string, string> = {
    inat: 'iNaturalist', fallingfruit: 'Falling Fruit', montreal: 'Ville de Montréal',
  };
  function guessCategory(p: any): string {
    if (p.source === 'montreal') return 'tree';
    const s = ((p.name || '') + ' ' + (p.species || '')).toLowerCase();
    if (/mushroom|bolet|morel|chanterelle|puffball|oyster/.test(s)) return 'mushrooms';
    if (/berr|grape|currant|elder|mulberry|serviceberry|raspberr|blackberr|haskap|cherry|plum|apple|pear|rose ?hip|hawthorn|rowan|sumac|juneberr/.test(s)) return 'berries';
    if (/walnut|butternut|hazel|chestnut|acorn|oak|hickory|ginkgo|beechnut|pine ?nut/.test(s)) return 'nuts';
    if (/mint|thyme|sage|balm|nettle|oregano|bergamot|yarrow|catnip/.test(s)) return 'herbs';
    if (/dandelion|chicory|purslane|lamb|sorrel|plantain|garlic mustard|clover|violet|chickweed|amaranth/.test(s)) return 'greens';
    return 'other';
  }

  // Popups are built as HTML strings, so any text that originates from the DB
  // (pin fields) or third parties (iNaturalist usernames on scouting pins) must be
  // escaped before interpolation. `seg` makes a value safe inside an href/src path.
  const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]);
  const seg = (s: any) => encodeURIComponent(String(s ?? ''));

  function pinIcon(color: string) {
    const svg =
      `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="40" viewBox="0 0 28 40">` +
      `<path d="M14 0C6.3 0 0 6.2 0 13.9 0 24 14 40 14 40s14-16 14-26.1C28 6.2 21.7 0 14 0z" fill="${color}"/>` +
      `<circle cx="14" cy="14" r="5.4" fill="#fff"/></svg>`;
    return L.divIcon({
      className: 'forage-pin',
      html: svg,
      iconSize: [28, 40],
      iconAnchor: [14, 40],
      popupAnchor: [0, -38],
    });
  }

  // Scouting pins encode SOURCE by shape, TIER by colour:
  //   iNaturalist = circle, Falling Fruit = diamond, Ville de Montréal = triangle.
  function scoutIcon(color: string) {
    const svg =
      `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20">` +
      `<circle cx="10" cy="10" r="7" fill="${color}" fill-opacity="0.85" stroke="#fff" stroke-width="2.5"/></svg>`;
    return L.divIcon({ className: 'scout-pin', html: svg, iconSize: [20, 20], iconAnchor: [10, 10], popupAnchor: [0, -10] });
  }

  function scoutDiamondIcon(color: string) {
    const svg =
      `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20">` +
      `<rect x="4.5" y="4.5" width="11" height="11" transform="rotate(45 10 10)" fill="${color}" fill-opacity="0.85" stroke="#fff" stroke-width="2.5"/></svg>`;
    return L.divIcon({ className: 'scout-pin scout-diamond', html: svg, iconSize: [20, 20], iconAnchor: [10, 10], popupAnchor: [0, -11] });
  }

  function scoutTriangleIcon(color: string) {
    const svg =
      `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20">` +
      `<path d="M10 3.2 17 16.4H3z" fill="${color}" fill-opacity="0.85" stroke="#fff" stroke-width="2.2" stroke-linejoin="round"/></svg>`;
    return L.divIcon({ className: 'scout-pin scout-triangle', html: svg, iconSize: [20, 20], iconAnchor: [10, 11], popupAnchor: [0, -10] });
  }

  const mapEl = document.getElementById('map');
  const isTouch = window.matchMedia('(pointer: coarse)').matches;

  const map = L.map('map', {
    scrollWheelZoom: false,   // desktop: unlock on click so page-scroll isn't hijacked
    tap: true,
  }).setView([45.462, -73.565], 13);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; OpenStreetMap contributors',
  }).addTo(map);
  map.on('click', () => map.scrollWheelZoom.enable());

  // ── User location ─────────────────────────────────────────────────────────
  // A "you are here" dot + accuracy halo. On the first fix we recenter the map
  // on the user (so they land in their area instead of the Montréal overview) —
  // unless they're far (>150 km) from the logged spots, where we keep the
  // overview. The locate button forces a fresh fix and surfaces a message when
  // the browser blocks/‌can't provide location (so it's never a silent no-op).
  let userMarker: any = null, accCircle: any = null;
  let didLocate = false, spotsBounds: any = null;
  const isFullMap = document.querySelector('.map-wrap')?.classList.contains('full');

  const userIcon = L.divIcon({
    className: 'user-loc',
    html: `<div class="user-dot"></div>`,
    iconSize: [24, 24],
    iconAnchor: [12, 12],
  });

  // A transient status line over the map (denied / unavailable / locating…).
  let msgTimer: any = null;
  function flash(text: string, sticky = false) {
    let el = document.getElementById('map-msg');
    if (!el) {
      el = document.createElement('div');
      el.id = 'map-msg';
      el.className = 'map-msg';
      (mapEl?.parentElement || mapEl)?.appendChild(el);
    }
    el.textContent = text;
    el.hidden = false;
    clearTimeout(msgTimer);
    if (!sticky) msgTimer = setTimeout(() => { if (el) el.hidden = true; }, 4000);
  }
  function clearFlash() {
    const el = document.getElementById('map-msg');
    if (el) el.hidden = true;
    clearTimeout(msgTimer);
  }

  function updatePosition(lat: number, lon: number, acc: number) {
    const ll = L.latLng(lat, lon);
    if (!userMarker) {
      userMarker = L.marker(ll, { icon: userIcon, interactive: false, keyboard: false, zIndexOffset: 1000 }).addTo(map);
      accCircle = L.circle(ll, {
        radius: acc || 0, interactive: false,
        color: '#1a73e8', weight: 1, opacity: 0.25, fillColor: '#1a73e8', fillOpacity: 0.12,
      }).addTo(map);
    } else {
      userMarker.setLatLng(ll);
      accCircle.setLatLng(ll).setRadius(acc || 0);
    }
  }

  function firstFix(ll: any) {
    if (didLocate) return;
    didLocate = true;
    // Center on the user unless they're far (>150 km) from the logged spots.
    const near = !spotsBounds || map.distance(ll, spotsBounds.getCenter()) < 150000;
    if (near) map.setView(ll, Math.max(map.getZoom(), 15), { animate: true });
  }

  function onFix(pos: any, recenter: boolean) {
    clearFlash();
    const { latitude, longitude, accuracy } = pos.coords;
    updatePosition(latitude, longitude, accuracy);
    if (recenter) map.setView([latitude, longitude], Math.max(map.getZoom(), 16), { animate: true });
    else firstFix(L.latLng(latitude, longitude));
  }

  function onError(err: any, loud: boolean) {
    if (!loud) return; // the silent passive watch shouldn't nag on load
    if (err && err.code === 1) flash('Location is blocked. Enable it for this site in your browser settings.', true);
    else flash('Couldn’t get your location — try again outdoors with a clear sky.');
  }

  let locating = false;
  function startLocating() {
    if (locating || !('geolocation' in navigator)) return;
    locating = true;
    navigator.geolocation.watchPosition(
      (pos) => onFix(pos, false),
      (err) => onError(err, false),
      { enableHighAccuracy: true, maximumAge: 10000, timeout: 20000 },
    );
  }

  // Button-driven locate: a one-shot fix that always recenters. Unlike the
  // passive watch it fires fresh on every tap and reports failures, so tapping
  // does something visible even when the on-load watch was denied or pending.
  function locateNow() {
    if (!('geolocation' in navigator)) { flash('This browser can’t share location.'); return; }
    flash('Locating…', true);
    navigator.geolocation.getCurrentPosition(
      (pos) => onFix(pos, true),
      (err) => onError(err, true),
      { enableHighAccuracy: true, maximumAge: 0, timeout: 20000 },
    );
    startLocating(); // keep the live watch going for continued tracking
  }

  const LocateCtl = L.Control.extend({
    onAdd: function () {
      const a = L.DomUtil.create('a', 'leaflet-bar locate-btn');
      a.href = '#'; a.title = 'Center on my location'; a.setAttribute('role', 'button');
      a.setAttribute('aria-label', 'Center on my location');
      a.innerHTML =
        `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">` +
        `<path fill="none" stroke="currentColor" stroke-width="2" d="M12 8a4 4 0 100 8 4 4 0 000-8zM12 2v3M12 19v3M2 12h3M19 12h3"/></svg>`;
      L.DomEvent.disableClickPropagation(a);
      L.DomEvent.on(a, 'click', L.DomEvent.stop);
      L.DomEvent.on(a, 'click', () => {
        if (userMarker) map.setView(userMarker.getLatLng(), Math.max(map.getZoom(), 16), { animate: true });
        else locateNow();
      });
      return a;
    },
  });
  new LocateCtl({ position: 'topleft' }).addTo(map);

  // Auto-locate on the dedicated fullscreen map (clear intent); the home embed
  // waits for a button tap so a homepage visit doesn't fire a permission prompt.
  if (isFullMap) startLocating();

  const usedCats = new Set<string>();

  // ── Layers panel (fullscreen map) ────────────────────────────────────────
  // One collapsible panel in the bottom-right (thumb reach) holding BOTH the
  // verified-pin legend and the scouting-leads filter. Collapsed by default so
  // it doesn't eat the screen; open state persists per-device. loadSpots() fills
  // the legend section, initScouting() fills the scouting section — both write
  // into the sections this creates, so it must exist before either runs.
  let panelLegendEl: HTMLElement | null = null;
  let panelScoutEl: HTMLElement | null = null;

  // ── Edit mode (?edit=1) ─────────────────────────────────────────────────
  // Pins become draggable so you can correct a spot whose photo-geolocation
  // landed it in the wrong place (the far side of a fence, etc.). Dropping a pin
  // PATCHes the live API, which persists it to the DB — no rebuild, shows for
  // everyone on the next load. Writes need the edit token (stored per-device).
  // Defined above initPanel so the panel's pencil toggle can gate on the token.
  // `editMode` is a live `let`, not a load-time const: the pencil flips it in
  // place (no reload, so map position/zoom are preserved) — long-press-move and
  // the promote button react to the current value rather than being wired once.
  let editMode = new URLSearchParams(location.search).get('edit') === '1';
  let editBtnEl: HTMLElement | null = null;
  const EDIT_MSG = '✎ Edit mode — press & hold a pin to lift it, then drag to its real spot.';
  const TOKEN_KEY = 'forage.editToken';
  const getToken = () => { try { return localStorage.getItem(TOKEN_KEY) || ''; } catch { return ''; } };
  const setToken = (t: string) => { try { localStorage.setItem(TOKEN_KEY, t); } catch {} };
  const clearToken = () => { try { localStorage.removeItem(TOKEN_KEY); } catch {} };
  function ensureToken(): string {
    let t = getToken();
    if (!t) {
      const entered = window.prompt('Enter your edit token to save pin moves:');
      if (entered) { t = entered.trim(); setToken(t); }
    }
    return t;
  }

  // Reflect the current editMode onto the DOM: a body class drives promote-button
  // visibility (popups are HTML, so CSS gates them reactively) and the pencil's
  // fill/label. Called on load and on every toggle.
  function applyEditState() {
    document.body.classList.toggle('map-editing', editMode);
    if (editBtnEl) {
      const t = editMode ? 'Exit edit mode' : 'Edit mode — move pins, promote leads';
      editBtnEl.classList.toggle('active', editMode);
      editBtnEl.title = t;
      editBtnEl.setAttribute('aria-label', t);
      editBtnEl.setAttribute('aria-pressed', String(editMode));
    }
  }
  // Flip edit mode without reloading — keep ?edit in the URL in sync (replaceState,
  // so it's still shareable/bookmarkable) but leave the map view untouched.
  function setEditMode(on: boolean) {
    editMode = on;
    const u = new URL(location.href);
    if (on) u.searchParams.set('edit', '1'); else u.searchParams.delete('edit');
    history.replaceState(null, '', u);
    applyEditState();
    if (on) flash(EDIT_MSG, true); else clearFlash();
  }

  function initPanel() {
    let open = loadPref('panel.open', false);
    // The pencil edit-toggle sits to the LEFT of the Layers pill on the same row,
    // but only once an edit token is stored (never shown to public visitors).
    // Clicking flips edit mode in place (setEditMode) — no reload, so the map view
    // is preserved.
    const canEdit = !!getToken();
    const editTitle = editMode ? 'Exit edit mode' : 'Edit mode — move pins, promote leads';
    const PanelCtl = L.Control.extend({
      onAdd: function () {
        const wrap = L.DomUtil.create('div', 'map-panel' + (open ? ' open' : ''));
        L.DomEvent.disableClickPropagation(wrap);
        L.DomEvent.disableScrollPropagation(wrap);
        wrap.innerHTML =
          `<div class="map-panel-bar">` +
            (canEdit
              ? `<button type="button" class="map-panel-edit${editMode ? ' active' : ''}" aria-pressed="${editMode}" title="${editTitle}" aria-label="${editTitle}">` +
                  `<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">` +
                    `<path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" d="M4 20l4.5-1L20 7.5 16.5 4 5 15.5 4 20zM14.5 6l3.5 3.5"/></svg>` +
                `</button>`
              : '') +
            `<button type="button" class="map-panel-toggle" aria-expanded="${open}" aria-label="Map layers & legend">` +
              `<svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">` +
                `<path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" d="M12 3l9 5-9 5-9-5 9-5zM3 12l9 5 9-5M3 16l9 5 9-5"/></svg>` +
              `<span>Layers</span></button>` +
          `</div>` +
          `<div class="map-panel-body"${open ? '' : ' hidden'}>` +
            `<div class="panel-sec" id="panel-legend" hidden></div>` +
            `<div class="panel-sec scout-ctl" id="panel-scout" hidden></div>` +
          `</div>`;
        const btn = wrap.querySelector('.map-panel-toggle') as HTMLElement;
        const body = wrap.querySelector('.map-panel-body') as HTMLElement;
        panelLegendEl = wrap.querySelector('#panel-legend');
        panelScoutEl = wrap.querySelector('#panel-scout');
        btn.addEventListener('click', () => {
          open = !open;
          savePref('panel.open', open);
          wrap.classList.toggle('open', open);
          body.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
        });
        editBtnEl = wrap.querySelector('.map-panel-edit') as HTMLElement | null;
        if (editBtnEl) editBtnEl.addEventListener('click', () => setEditMode(!editMode));
        return wrap;
      },
    });
    new PanelCtl({ position: 'bottomright' }).addTo(map);
  }
  if (isFullMap) initPanel();
  applyEditState(); // reflect the initial ?edit state onto body + pencil

  // Optional ?plant=<slug> filter: a plant page can deep-link here to show only
  // the spots that link back to it (properties.plant === slug) — both confirmed
  // pins AND scouting leads for that plant.
  const plantFilter = new URLSearchParams(location.search).get('plant');

  // The deep-linked banner reports confirmed + lead counts, but those arrive via
  // two independent async paths (loadSpots / initScouting); each updates its own
  // slice then re-renders so the banner is correct whichever finishes last.
  let fbConfirmed = 0, fbLeads = 0, fbLabel = '';
  function renderFilterBanner() {
    const el = document.getElementById('map-filter');
    if (!el || !plantFilter) return;
    const parts = [`${fbConfirmed} confirmed spot${fbConfirmed === 1 ? '' : 's'}`];
    if (fbLeads) parts.push(`${fbLeads} scouting lead${fbLeads === 1 ? '' : 's'}`);
    el.innerHTML =
      `<span>Showing ${parts.join(' + ')} for <strong>${esc(fbLabel || plantFilter)}</strong>.</span>` +
      `<a href="/map">Show all spots →</a>`;
    el.hidden = false;
  }

  // Drop a freshly-created confirmed pin onto the map immediately after a promote,
  // so it shows without a reload (the DB is already updated). `spot` is the flat
  // row the API returns from POST /api/pins.
  function addConfirmedMarker(spot: any, category: string) {
    const cat = category || spot.category || 'other';
    const m = L.marker([spot.lat, spot.lon], { icon: pinIcon(CAT_COLORS[cat] || CAT_COLORS.other) }).addTo(map);
    m.bindPopup(
      `<div class="p-pop"><h3>${esc(spot.name) || 'Spot'}</h3>` +
        (spot.species ? `<div class="p-sci">${esc(spot.species)}</div>` : '') +
        (spot.notes ? `<div class="p-meta">${esc(spot.notes)}</div>` : '') +
        (spot.plant ? `<a class="p-guide" href="/plants/${seg(spot.plant)}">View plant guide →</a>` : '') +
      `</div>`,
      { maxWidth: 244, minWidth: 200, maxHeight: 300, autoPan: true, keepInView: true },
    ).openPopup();
  }

  async function saveMove(id: number, marker: any, origin: any) {
    const token = ensureToken();
    if (!token) { marker.setLatLng(origin); flash('No token — move not saved.'); return; }
    const { lat, lng } = marker.getLatLng();
    flash('Saving…', true);
    try {
      const r = await fetch('/api/pins/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
        body: JSON.stringify({ lon: +lng.toFixed(6), lat: +lat.toFixed(6) }),
      });
      if (r.status === 401) { clearToken(); marker.setLatLng(origin); flash('Edit token rejected — moved back. Drag again to re-enter it.', true); return; }
      if (!r.ok) { const e = await r.json().catch(() => ({})); throw new Error(e.error || ('HTTP ' + r.status)); }
      flash('Saved ✓');
    } catch (err: any) {
      marker.setLatLng(origin);
      flash('Save failed (' + (err?.message || err) + ') — moved back.');
    }
  }

  // Long-press to move (mobile-safe). Pins are inert to touch by default so you
  // can pan the map freely; press-and-hold ~0.45s on a pin to "lift" it, then drag
  // and release to drop. Moving the finger before the hold completes is treated as
  // a pan and never grabs the pin — which was the old draggable-marker footgun.
  function enableLongPressMove(marker: any, id: number) {
    const ARM_MS = 450, SLOP = 10;
    let timer: any = null, armed = false, start: any = null, originLL: any = null;

    const arm = () => {
      armed = true;
      originLL = marker.getLatLng();
      map.dragging.disable();               // don't pan while a pin is lifted
      marker.getElement()?.classList.add('pin-armed');
      try { (navigator as any).vibrate?.(30); } catch {}
      flash('Pin lifted — drag to move, release to drop.', true);
    };
    const disarm = () => {
      map.dragging.enable();
      marker.getElement()?.classList.remove('pin-armed');
    };
    const onMove = (e: any) => {
      if (!armed) {
        // A move before the hold completes = a pan/tap; abandon arming.
        if (start && Math.hypot(e.clientX - start.x, e.clientY - start.y) > SLOP) { clearTimeout(timer); cleanup(); }
        return;
      }
      e.preventDefault();
      marker.setLatLng(map.mouseEventToLatLng(e));
    };
    const onUp = (e: any) => {
      clearTimeout(timer);
      if (armed) {
        e.preventDefault?.();
        disarm();
        suppressNextClick(marker.getElement()); // don't pop the popup right after a move
        saveMove(id, marker, originLL);
      }
      cleanup();
    };
    const onCancel = () => {
      clearTimeout(timer);
      if (armed) { marker.setLatLng(originLL); disarm(); }
      cleanup();
    };
    const cleanup = () => {
      armed = false; start = null;
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      window.removeEventListener('pointercancel', onCancel);
    };
    const onDown = (e: any) => {
      if (!editMode) return; // handler is always attached; only arms while editing
      if (e.button != null && e.button > 0) return; // primary button / touch only
      start = { x: e.clientX, y: e.clientY };
      timer = setTimeout(arm, ARM_MS);
      window.addEventListener('pointermove', onMove, { passive: false });
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', onCancel);
    };
    marker.on('add', () => marker.getElement()?.addEventListener('pointerdown', onDown));
  }

  function suppressNextClick(el: any) {
    if (!el) return;
    const h = (ev: any) => { ev.stopPropagation(); ev.preventDefault(); el.removeEventListener('click', h, true); };
    el.addEventListener('click', h, true);
    setTimeout(() => el.removeEventListener('click', h, true), 500);
  }

  // Pins load live from the API; fall back to the build-time static export if the
  // API is unreachable, so the map still renders when the service is down.
  async function loadSpots() {
    try {
      const r = await fetch('/api/pins', { cache: 'no-store' });
      if (r.ok) return await r.json();
    } catch {}
    const r = await fetch('/data/foraging-spots.geojson?t=' + Date.now(), { cache: 'no-store' });
    return r.json();
  }

  loadSpots()
    .then((geo) => {
      if (editMode) flash(EDIT_MSG, true);
      const layer = L.geoJSON(geo, {
        filter: (feature) =>
          !plantFilter || feature.properties?.plant === plantFilter,
        pointToLayer: (feature, latlng) => {
          const cat = feature.properties?.category || 'other';
          usedCats.add(cat);
          return L.marker(latlng, { icon: pinIcon(CAT_COLORS[cat] || CAT_COLORS.other) });
        },
        onEachFeature: (feature, lyr) => {
          const p = feature.properties || {};
          // Always wire long-press-move; it only arms while editMode is on, so a
          // live toggle needs no re-binding.
          if (typeof feature.id === 'number') {
            enableLongPressMove(lyr, feature.id as number);
          }
          const photos: string[] = Array.isArray(p.photos) ? p.photos : [];
          const imgs = photos
            .map((f) => `<a href="/photos/spots/${seg(f)}" target="_blank" rel="noopener"><img src="/photos/spots/${seg(f)}" alt="${esc(p.name)}" loading="lazy" /></a>`)
            .join('');
          lyr.bindPopup(
            `<div class="p-pop">` +
              `<h3>${esc(p.name) || 'Spot'}</h3>` +
              (p.species ? `<div class="p-sci">${esc(p.species)}</div>` : '') +
              (p.season ? `<div class="p-meta">🗓 ${esc(p.season)}</div>` : '') +
              (p.location ? `<div class="p-meta">📍 ${esc(p.location)}</div>` : '') +
              (p.notes ? `<div class="p-meta">${esc(p.notes)}</div>` : '') +
              imgs +
              (p.plant ? `<a class="p-guide" href="/plants/${seg(p.plant)}">View plant guide →</a>` : '') +
            `</div>`,
            // Keep popups compact so they never overflow the viewport; the inner
            // content scrolls if long, and Leaflet pans to keep it in view.
            { maxWidth: 244, minWidth: 200, maxHeight: 300, autoPan: true, keepInView: true },
          );
        },
      }).addTo(map);

      try {
        const b = layer.getBounds();
        // Keep bounds for the geolocation "near the spots?" test; only fit them
        // if the user hasn't already been located and centered.
        if (b.isValid()) { spotsBounds = b; if (!didLocate) map.fitBounds(b.pad(0.35)); }
      } catch {}

      // When deep-linked to one plant, feed the confirmed count + label into the
      // shared banner (initScouting adds the lead count via the same renderer).
      if (plantFilter) {
        const match = (geo.features || []).find(
          (f: any) => f.properties?.plant === plantFilter,
        );
        fbConfirmed = layer.getLayers().length;
        if (match) fbLabel = match.properties?.species || match.properties?.name || '';
        renderFilterBanner();
      }

      // Re-measure once the container has its final (flex/fullscreen) size.
      setTimeout(() => map.invalidateSize(), 60);

      const legendItems = [...usedCats]
        .sort()
        .map((c) => `<span><i class="dot" style="background:${CAT_COLORS[c] || CAT_COLORS.other}"></i>${esc(c)}</span>`)
        .join('');
      // Fullscreen: the legend lives inside the collapsible bottom-right panel.
      // Home embed: it stays inline below the map.
      if (isFullMap && panelLegendEl) {
        panelLegendEl.innerHTML = `<h4 class="panel-h">Foraging spots</h4><div class="legend">${legendItems}</div>`;
        panelLegendEl.hidden = false;
      } else {
        const legend = document.getElementById('legend');
        if (legend) legend.innerHTML = legendItems;
      }
    })
    .catch((err) => {
      if (mapEl) mapEl.innerHTML = '<p style="padding:20px">Could not load map data.</p>';
      console.error(err);
    });

  // ── Scouting layer ──────────────────────────────────────────────────────
  // Only on the fullscreen map page, never the home embed. Unverified iNat
  // leads, off by default; visibility + per-tier filter persist in localStorage.
  // Under a ?plant= filter we still run it, but restricted to that plant's leads
  // and forced visible (so the guide's "on map" link surfaces leads, not just
  // confirmed pins). Unfiltered, it's the full off-by-default layer as before.
  const isMapPage = document.querySelector('.map-wrap')?.classList.contains('full');
  if (isMapPage) initScouting();

  function loadPref(key: string, fallback: boolean) {
    try { const v = localStorage.getItem(key); return v === null ? fallback : v === '1'; }
    catch { return fallback; }
  }
  function savePref(key: string, on: boolean) {
    try { localStorage.setItem(key, on ? '1' : '0'); } catch {}
  }

  // Locally-hidden scouting pins (e.g. one that turned out to sit in someone's
  // private garden). Stored as a set of `${source}:${id}` keys in localStorage so
  // a hide is stable across reloads AND data regenerations, and never collides
  // between sources. Per-device by nature. Legacy entries were bare iNat obs ids
  // (numbers) — migrate those to `inat:<n>` on load.
  function loadHidden(): Set<string> {
    try {
      const arr = JSON.parse(localStorage.getItem('scout.hidden') || '[]');
      return new Set(arr.map((v: any) => (typeof v === 'number' ? 'inat:' + v : String(v))));
    } catch { return new Set(); }
  }
  function saveHidden(s: Set<string>) {
    try { localStorage.setItem('scout.hidden', JSON.stringify([...s])); } catch {}
  }

  function scoutPopup(p: any, key: string) {
    const tier = p.tier || 'snack';
    const isFF = p.source === 'fallingfruit';
    const isMtl = p.source === 'montreal';
    const isINat = !isFF && !isMtl;
    const mtlMeta = [p.where && esc(p.where), p.planted && ('planted ' + esc(p.planted))].filter(Boolean).join(' · ');
    return (
      `<div class="p-pop">` +
        `<h3>${esc(p.name) || 'Observation'}</h3>` +
        (p.species ? `<div class="p-sci">${esc(p.species)}</div>` : '') +
        `<div class="p-tier tier-${esc(tier)}">${TIER_LABEL[tier] || esc(tier)}</div>` +
        (p.notes ? `<div class="p-meta">${esc(p.notes)}</div>` : '') +
        (isINat && p.observed ? `<div class="p-meta p-obs">🔍 iNat obs ${esc(p.observed)}${p.observer ? ' · @' + esc(p.observer) : ''}${p.obscured ? ' · ⚠ location obscured' : ''}</div>` : '') +
        (isFF ? `<div class="p-meta p-obs">◆ Falling Fruit · community spot</div>` : '') +
        (isMtl ? `<div class="p-meta p-obs">▲ Ville de Montréal · city tree${mtlMeta ? ' · ' + mtlMeta : ''}</div>` : '') +
        (isINat && /^https?:\/\//i.test(p.inat || '') ? `<a class="p-guide" href="${esc(p.inat)}" target="_blank" rel="noopener">View on iNaturalist →</a>` : '') +
        (isFF && /^https?:\/\//i.test(p.ff || '') ? `<a class="p-guide" href="${esc(p.ff)}" target="_blank" rel="noopener">View on Falling Fruit →</a>` : '') +
        (isMtl && /^https?:\/\//i.test(p.mtl || '') ? `<a class="p-guide" href="${esc(p.mtl)}" target="_blank" rel="noopener">City tree dataset →</a>` : '') +
        (p.plant ? `<a class="p-guide" href="/plants/${seg(p.plant)}">View plant guide →</a>` : '') +
        `<button type="button" class="scout-promote" data-promote="${esc(key)}">➕ Promote to confirmed spot</button>` +
        `<button type="button" class="scout-hide" data-hide="${esc(key)}">✕ Hide this pin</button>` +
      `</div>`
    );
  }

  function initScouting() {
    // Scouting sources: shape encodes provenance (circle vs diamond), colour the
    // tier. Each is an independent, separately-toggled layer; tier filters + Hide
    // apply across both. `legacyOn` maps the old single `scout.on` pref onto iNat.
    // Declared here (not module scope) so it initialises when the function runs —
    // initScouting() is invoked earlier in the script than this point.
    const SCOUT_SOURCES = [
      { key: 'inat', label: 'iNaturalist', glyph: '●', tag: 'research-grade · unverified',
        url: '/data/scouting-spots.geojson', icon: scoutIcon, legacyOn: true, attrib: '' },
      { key: 'ff', label: 'Falling Fruit', glyph: '◆', tag: 'community · CC BY-NC-SA',
        url: '/data/falling-fruit.geojson', icon: scoutDiamondIcon, legacyOn: false,
        attrib: 'Community spots via <a href="https://fallingfruit.org" target="_blank" rel="noopener">Falling Fruit</a> (CC BY-NC-SA)' },
      { key: 'montreal', label: 'City trees', glyph: '▲', tag: 'city inventory · sample',
        url: '/data/montreal-trees.geojson', icon: scoutTriangleIcon, legacyOn: false,
        attrib: 'Public-tree inventory © <a href="https://donnees.montreal.ca/dataset/arbres" target="_blank" rel="noopener">Ville de Montréal</a> (CC BY 4.0)' },
    ];
    const hidden = loadHidden();
    // One marker-cluster group holds every visible scouting marker across all
    // sources/tiers — nearby pins collapse into a counted bubble that splits apart
    // as you zoom, so thousands of city trees stay usable instead of melting the
    // browser. `records` tracks each marker's source+tier for the filters, counts,
    // and Hide; `inCluster` mirrors what's currently added so a filter toggle diffs
    // membership instead of rebuilding the whole layer.
    const cluster = (L as any).markerClusterGroup({
      maxClusterRadius: 55,
      showCoverageOnHover: false,
      spiderfyOnMaxZoom: true,
      chunkedLoading: true,
      iconCreateFunction: (c: any) => {
        const n = c.getChildCount();
        const size = n < 10 ? 34 : n < 100 ? 40 : 48;
        return L.divIcon({ html: `<span>${n}</span>`, className: 'scout-cluster', iconSize: [size, size] });
      },
    });
    const present: Record<string, Set<string>> = {};
    const records: Array<{ srcKey: string; key: string; tier: string; marker: any; props: any; lat: number; lon: number }> = [];
    const inCluster = new Set<string>();

    Promise.all(SCOUT_SOURCES.map(async (src) => {
      let geo: any;
      try {
        const r = await fetch(src.url + '?t=' + Date.now(), { cache: 'no-store' });
        if (!r.ok) return;
        geo = await r.json();
      } catch { return; }
      present[src.key] = new Set();
      (geo.features || []).forEach((f: any, i: number) => {
        const p = f.properties || {};
        if (plantFilter && p.plant !== plantFilter) return; // deep-linked: this plant's leads only
        const tier = p.tier || 'snack';
        if (!TIER_ORDER.includes(tier)) return;
        present[src.key].add(tier);
        const id = (f.id !== undefined && f.id !== null) ? f.id : `${src.key}${i}`;
        const key = `${src.key}:${id}`;
        const [lon, lat] = f.geometry.coordinates;
        const marker = L.marker([lat, lon], { icon: src.icon(TIER_COLORS[tier] || '#7a7a7a') })
          // closeOnClick/autoClose off: the Promote flow expands an inline form in
          // the popup, so a stray map click must not tear it down mid-edit. The
          // popup's own X (and Hide/Cancel) still close it explicitly.
          .bindPopup(scoutPopup(p, key), { maxWidth: 244, minWidth: 200, maxHeight: 300, autoPan: true, keepInView: true, closeOnClick: false, autoClose: false });
        records.push({ srcKey: src.key, key, tier, marker, props: p, lat, lon });
      });
    })).then(() => {
      // Under a plant filter, feed the lead count into the shared deep-link banner
      // (loadSpots supplies the confirmed count + label; either may finish first).
      if (plantFilter) {
        fbLeads = records.length;
        if (!fbLabel && records[0]) fbLabel = records[0].props.species || records[0].props.name || '';
        renderFilterBanner();
      }
      const div = panelScoutEl;
      if (!div) return; // not the fullscreen map — nothing to draw into
      const liveSources = SCOUT_SOURCES.filter((s) => present[s.key]?.size);
      if (!liveSources.length) return;
      div.hidden = false;
      cluster.addTo(map);

      // Per-source master toggles (persisted); shared per-tier filters. Under a
      // plant filter the leads are forced visible (the guide link means to show
      // them) rather than honouring the off-by-default persisted prefs.
      const state = { master: {} as Record<string, boolean>, tier: {} as Record<string, boolean> };
      for (const s of SCOUT_SOURCES) {
        const fallback = s.legacyOn ? loadPref('scout.on', false) : false;
        state.master[s.key] = plantFilter ? true : loadPref('scout.on.' + s.key, fallback);
      }
      for (const t of TIER_ORDER) state.tier[t] = loadPref('scout.tier.' + t, true);

      // Diff cluster membership against the filter state (add/remove only deltas).
      const apply = () => {
        const add: any[] = [], remove: any[] = [];
        for (const rec of records) {
          const visible = state.master[rec.srcKey] && state.tier[rec.tier] && !hidden.has(rec.key);
          if (visible && !inCluster.has(rec.key)) { add.push(rec.marker); inCluster.add(rec.key); }
          else if (!visible && inCluster.has(rec.key)) { remove.push(rec.marker); inCluster.delete(rec.key); }
        }
        if (remove.length) cluster.removeLayers(remove);
        if (add.length) cluster.addLayers(add);
      };
      apply();

      let renderCtl = () => {};
      const hidePin = (key: string) => {
        const rec = records.find((r) => r.key === key);
        if (!rec) return;
        hidden.add(key);
        saveHidden(hidden);
        if (inCluster.has(key)) { cluster.removeLayer(rec.marker); inCluster.delete(key); }
        map.closePopup();
        renderCtl();
      };
      const unhideAll = () => {
        hidden.clear();
        saveHidden(hidden);
        apply();
        renderCtl();
      };
      // Promote a lead → a confirmed spot. The lead has everything a pin needs
      // except `category`, so the button expands to a category picker in-place,
      // then POSTs /api/pins with the token. On success we drop a real pin now and
      // retire the lead locally (hidden, so a data regen won't resurrect it).
      const startPromote = (key: string, popupEl: HTMLElement) => {
        const rec = records.find((r) => r.key === key);
        const btn = popupEl.querySelector('.scout-promote') as HTMLElement | null;
        if (!rec || !btn) return;
        const guess = guessCategory(rec.props);
        const opts = CATEGORIES.map((c) => `<option value="${c}"${c === guess ? ' selected' : ''}>${c}</option>`).join('');
        const form = document.createElement('div');
        form.className = 'promote-form';
        form.innerHTML =
          `<label class="promote-cat-l">Category <select class="promote-cat">${opts}</select></label>` +
          `<div class="promote-actions">` +
            `<button type="button" class="promote-go">Confirm spot</button>` +
            `<button type="button" class="promote-cancel">Cancel</button>` +
          `</div>`;
        btn.replaceWith(form);
        (form.querySelector('.promote-cancel') as HTMLElement).addEventListener('click', () => map.closePopup());
        (form.querySelector('.promote-go') as HTMLElement).addEventListener('click', () =>
          doPromote(rec, (form.querySelector('.promote-cat') as HTMLSelectElement).value, form));
      };

      const doPromote = async (rec: any, category: string, form: HTMLElement) => {
        const token = ensureToken();
        const go = form.querySelector('.promote-go') as HTMLButtonElement | null;
        if (!token) { flash('No token — spot not created.'); return; }
        if (go) { go.disabled = true; go.textContent = 'Saving…'; }
        const p = rec.props;
        const notes = [p.notes, `↗ promoted from ${SRC_LABEL[p.source] || 'scouting'} lead`].filter(Boolean).join(' · ');
        try {
          const r = await fetch('/api/pins', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({
              name: p.name || p.species || 'Spot',
              category,
              species: p.species ?? null,
              notes,
              plant: p.plant ?? null,
              lon: +Number(rec.lon).toFixed(6),
              lat: +Number(rec.lat).toFixed(6),
            }),
          });
          if (r.status === 401) { clearToken(); flash('Edit token rejected — try again to re-enter it.', true); if (go) { go.disabled = false; go.textContent = 'Confirm spot'; } return; }
          if (!r.ok) { const e = await r.json().catch(() => ({})); throw new Error(e.error || ('HTTP ' + r.status)); }
          const { spot } = await r.json();
          map.closePopup();
          hidePin(rec.key);                 // retire the lead (persists across regens)
          addConfirmedMarker(spot, category); // show the new pin immediately
          flash('Promoted ✓ — now a confirmed spot.');
        } catch (err: any) {
          flash('Promote failed (' + (err?.message || err) + ').');
          if (go) { go.disabled = false; go.textContent = 'Confirm spot'; }
        }
      };

      // Popups are HTML strings — wire their Hide / Promote buttons on open.
      map.on('popupopen', (e: any) => {
        const el = e.popup.getElement();
        if (!el) return;
        // Keep in-popup clicks (esp. Promote → its inline form) from bubbling to
        // the map, which would close the popup and tear the form down mid-flow.
        L.DomEvent.disableClickPropagation(el);
        const hb = el.querySelector('.scout-hide');
        if (hb) hb.addEventListener('click', () => hidePin(String(hb.dataset.hide)), { once: true });
        const pb = el.querySelector('.scout-promote');
        if (pb) pb.addEventListener('click', () => startPromote(String(pb.dataset.promote), el), { once: true });
      });

      const tiersShown = TIER_ORDER.filter((t) => records.some((r) => r.tier === t));
      const tierCount = (t: string) => records.filter((r) => r.tier === t && !hidden.has(r.key)).length;

      renderCtl = () => {
        div.innerHTML =
          `<h4 class="panel-h">Scouting leads <em>unverified — go confirm</em></h4>` +
          liveSources.map((s) =>
            `<label class="scout-master"><input type="checkbox" data-src="${s.key}"${state.master[s.key] ? ' checked' : ''}>` +
            `<span class="scout-src"><b>${s.glyph} ${s.label}</b><em>${s.tag}</em></span></label>`,
          ).join('') +
          `<div class="scout-tiers" id="scout-tiers">` +
          `<div class="scout-tiers-h">Filter by type</div>` +
          tiersShown.map((t) =>
            `<label class="scout-tier"><input type="checkbox" data-tier="${t}"${state.tier[t] ? ' checked' : ''}>` +
            `<i class="dot" style="background:${TIER_COLORS[t]}"></i>${TIER_LABEL[t]} <b>${tierCount(t)}</b></label>`,
          ).join('') +
          (hidden.size ? `<button type="button" class="scout-unhide">↺ Restore ${hidden.size} hidden pin${hidden.size === 1 ? '' : 's'}</button>` : '') +
          `</div>` +
          liveSources.filter((s) => s.attrib).map((s) => `<p class="scout-attrib">${s.attrib}</p>`).join('');
        div.querySelectorAll('input[data-src]').forEach((el) => {
          el.addEventListener('change', () => {
            const k = (el as HTMLInputElement).dataset.src as string;
            state.master[k] = (el as HTMLInputElement).checked;
            savePref('scout.on.' + k, state.master[k]);
            apply();
          });
        });
        div.querySelectorAll('input[data-tier]').forEach((el) => {
          el.addEventListener('change', () => {
            const t = (el as HTMLInputElement).dataset.tier as string;
            state.tier[t] = (el as HTMLInputElement).checked;
            savePref('scout.tier.' + t, state.tier[t]);
            apply();
          });
        });
        const unhideEl = div.querySelector('.scout-unhide');
        if (unhideEl) unhideEl.addEventListener('click', unhideAll);
      };
      renderCtl();
    });
  }

  window.addEventListener('resize', () => map.invalidateSize());
  void isTouch;
</script>
