---
// Client-side Leaflet map. Pins load live from the /api/pins data API (the SQLite
// DB is the source of truth), falling back to the build-time static export at
// /data/foraging-spots.geojson if the API is unreachable.
// `fullscreen` makes the map fill the viewport below the header (map page);
// otherwise it's a boxed embed (home page).
interface Props { fullscreen?: boolean; }
const { fullscreen = false } = Astro.props;
---
<div class={`map-wrap${fullscreen ? ' full' : ''}`}>
  <div class="map-shell"><div id="map"></div></div>
  <div class="map-filter" id="map-filter" hidden></div>
  <div class="legend" id="legend"></div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" crossorigin="" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" crossorigin="" />

<script>
  import L from 'leaflet';
  import 'leaflet.markercluster';

  // ONE colour axis for every pin: category (what it is / which food part). Shape
  // encodes provenance — confirmed spots are prominent teardrops, leads are smaller
  // source-shaped markers (circle iNat / diamond FF / triangle city). An amber ring
  // flags a dangerous lookalike (`caution`), the one bit of the old tier system
  // worth keeping. No second colour system.
  const CAT_COLORS: Record<string, string> = {
    fruit: '#8a2f4a', nuts: '#8a6d3b', greens: '#2f7d4f', herbs: '#4a8f7b',
    mushrooms: '#9c6b4a', other: '#7a7a7a',
  };
  const CAT_LABEL: Record<string, string> = {
    fruit: 'Fruit & berries', nuts: 'Nuts', greens: 'Greens', herbs: 'Herbs & tea',
    mushrooms: 'Mushrooms', other: 'Other',
  };
  const CAT_ORDER = ['fruit', 'nuts', 'greens', 'herbs', 'mushrooms', 'other'];
  const CATEGORIES = CAT_ORDER;
  const CAUTION_COLOR = '#d98a2b';
  const SRC_LABEL: Record<string, string> = {
    confirmed: 'My spot', inat: 'iNaturalist', fallingfruit: 'Falling Fruit', montreal: 'Ville de Montréal',
  };

  // Popups are built as HTML strings, so any text that originates from the DB
  // (pin fields) or third parties (iNaturalist usernames on scouting pins) must be
  // escaped before interpolation. `seg` makes a value safe inside an href/src path.
  const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]);
  const seg = (s: any) => encodeURIComponent(String(s ?? ''));

  // Confirmed spot: a prominent teardrop, category-coloured. A caution find gets an
  // amber outline so a dangerous-lookalike still reads at a glance.
  function pinIcon(color: string, caution = false) {
    const stroke = caution ? ` stroke="${CAUTION_COLOR}" stroke-width="2.6"` : '';
    const svg =
      `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="40" viewBox="0 0 28 40">` +
      `<path d="M14 0C6.3 0 0 6.2 0 13.9 0 24 14 40 14 40s14-16 14-26.1C28 6.2 21.7 0 14 0z" fill="${color}"${stroke}/>` +
      `<circle cx="14" cy="14" r="5.4" fill="#fff"/></svg>`;
    return L.divIcon({
      className: 'forage-pin' + (caution ? ' is-caution' : ''),
      html: svg,
      iconSize: [28, 40],
      iconAnchor: [14, 40],
      popupAnchor: [0, -38],
    });
  }

  // Lead: smaller marker, SHAPE = source (circle iNat / diamond FF / triangle city),
  // FILL = category. White ring normally; amber ring when caution.
  function leadIcon(shape: string, color: string, caution = false) {
    const ring = caution ? CAUTION_COLOR : '#fff';
    const w = caution ? 3 : 2.5;
    let body: string, anchorY = 10, cls = 'scout-pin';
    if (shape === 'diamond') {
      body = `<rect x="4.5" y="4.5" width="11" height="11" transform="rotate(45 10 10)" fill="${color}" fill-opacity="0.85" stroke="${ring}" stroke-width="${w}"/>`;
      cls += ' scout-diamond';
    } else if (shape === 'triangle') {
      body = `<path d="M10 3.2 17 16.4H3z" fill="${color}" fill-opacity="0.85" stroke="${ring}" stroke-width="${caution ? 2.8 : 2.2}" stroke-linejoin="round"/>`;
      cls += ' scout-triangle'; anchorY = 11;
    } else {
      body = `<circle cx="10" cy="10" r="7" fill="${color}" fill-opacity="0.85" stroke="${ring}" stroke-width="${w}"/>`;
    }
    if (caution) cls += ' is-caution';
    return L.divIcon({
      className: cls,
      html: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20">${body}</svg>`,
      iconSize: [20, 20], iconAnchor: [10, anchorY], popupAnchor: [0, -10],
    });
  }
  const SOURCE_SHAPE: Record<string, string> = { inat: 'circle', fallingfruit: 'diamond', montreal: 'triangle' };

  const mapEl = document.getElementById('map');
  const isTouch = window.matchMedia('(pointer: coarse)').matches;

  const map = L.map('map', {
    scrollWheelZoom: false,   // desktop: unlock on click so page-scroll isn't hijacked
    tap: true,
  }).setView([45.462, -73.565], 13);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; OpenStreetMap contributors',
  }).addTo(map);
  map.on('click', () => map.scrollWheelZoom.enable());

  // ── User location ─────────────────────────────────────────────────────────
  // A "you are here" dot + accuracy halo. On the first fix we recenter the map
  // on the user (so they land in their area instead of the Montréal overview) —
  // unless they're far (>150 km) from the logged spots, where we keep the
  // overview. The locate button forces a fresh fix and surfaces a message when
  // the browser blocks/‌can't provide location (so it's never a silent no-op).
  let userMarker: any = null, accCircle: any = null;
  let didLocate = false, spotsBounds: any = null;
  const isFullMap = document.querySelector('.map-wrap')?.classList.contains('full');

  const userIcon = L.divIcon({
    className: 'user-loc',
    html: `<div class="user-dot"></div>`,
    iconSize: [24, 24],
    iconAnchor: [12, 12],
  });

  // A transient status line over the map (denied / unavailable / locating…).
  let msgTimer: any = null;
  function flash(text: string, sticky = false) {
    let el = document.getElementById('map-msg');
    if (!el) {
      el = document.createElement('div');
      el.id = 'map-msg';
      el.className = 'map-msg';
      (mapEl?.parentElement || mapEl)?.appendChild(el);
    }
    el.textContent = text;
    el.hidden = false;
    clearTimeout(msgTimer);
    if (!sticky) msgTimer = setTimeout(() => { if (el) el.hidden = true; }, 4000);
  }
  function clearFlash() {
    const el = document.getElementById('map-msg');
    if (el) el.hidden = true;
    clearTimeout(msgTimer);
  }

  function updatePosition(lat: number, lon: number, acc: number) {
    const ll = L.latLng(lat, lon);
    if (!userMarker) {
      userMarker = L.marker(ll, { icon: userIcon, interactive: false, keyboard: false, zIndexOffset: 1000 }).addTo(map);
      accCircle = L.circle(ll, {
        radius: acc || 0, interactive: false,
        color: '#1a73e8', weight: 1, opacity: 0.25, fillColor: '#1a73e8', fillOpacity: 0.12,
      }).addTo(map);
    } else {
      userMarker.setLatLng(ll);
      accCircle.setLatLng(ll).setRadius(acc || 0);
    }
  }

  function firstFix(ll: any) {
    if (didLocate) return;
    didLocate = true;
    // Center on the user unless they're far (>150 km) from the logged spots.
    const near = !spotsBounds || map.distance(ll, spotsBounds.getCenter()) < 150000;
    if (near) map.setView(ll, Math.max(map.getZoom(), 15), { animate: true });
  }

  function onFix(pos: any, recenter: boolean) {
    clearFlash();
    const { latitude, longitude, accuracy } = pos.coords;
    updatePosition(latitude, longitude, accuracy);
    if (recenter) map.setView([latitude, longitude], Math.max(map.getZoom(), 16), { animate: true });
    else firstFix(L.latLng(latitude, longitude));
  }

  function onError(err: any, loud: boolean) {
    if (!loud) return; // the silent passive watch shouldn't nag on load
    if (err && err.code === 1) flash('Location is blocked. Enable it for this site in your browser settings.', true);
    else flash('Couldn’t get your location — try again outdoors with a clear sky.');
  }

  let locating = false;
  function startLocating() {
    if (locating || !('geolocation' in navigator)) return;
    locating = true;
    navigator.geolocation.watchPosition(
      (pos) => onFix(pos, false),
      (err) => onError(err, false),
      { enableHighAccuracy: true, maximumAge: 10000, timeout: 20000 },
    );
  }

  // Button-driven locate: a one-shot fix that always recenters. Unlike the
  // passive watch it fires fresh on every tap and reports failures, so tapping
  // does something visible even when the on-load watch was denied or pending.
  function locateNow() {
    if (!('geolocation' in navigator)) { flash('This browser can’t share location.'); return; }
    flash('Locating…', true);
    navigator.geolocation.getCurrentPosition(
      (pos) => onFix(pos, true),
      (err) => onError(err, true),
      { enableHighAccuracy: true, maximumAge: 0, timeout: 20000 },
    );
    startLocating(); // keep the live watch going for continued tracking
  }

  const LocateCtl = L.Control.extend({
    onAdd: function () {
      const a = L.DomUtil.create('a', 'leaflet-bar locate-btn');
      a.href = '#'; a.title = 'Center on my location'; a.setAttribute('role', 'button');
      a.setAttribute('aria-label', 'Center on my location');
      a.innerHTML =
        `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">` +
        `<path fill="none" stroke="currentColor" stroke-width="2" d="M12 8a4 4 0 100 8 4 4 0 000-8zM12 2v3M12 19v3M2 12h3M19 12h3"/></svg>`;
      L.DomEvent.disableClickPropagation(a);
      L.DomEvent.on(a, 'click', L.DomEvent.stop);
      L.DomEvent.on(a, 'click', () => {
        if (userMarker) map.setView(userMarker.getLatLng(), Math.max(map.getZoom(), 16), { animate: true });
        else locateNow();
      });
      return a;
    },
  });
  new LocateCtl({ position: 'topleft' }).addTo(map);

  // Auto-locate on the dedicated fullscreen map (clear intent); the home embed
  // waits for a button tap so a homepage visit doesn't fire a permission prompt.
  if (isFullMap) startLocating();


  // ── Layers panel (fullscreen map) ────────────────────────────────────────
  // One collapsible panel in the bottom-right (thumb reach) holding the layer
  // toggles (My spots + each lead source) and the type/caution filters. Collapsed
  // by default so it doesn't eat the screen; open state persists per-device.
  // initFullMap() writes into #panel-scout, which must exist before it runs.
  let panelLegendEl: HTMLElement | null = null;
  let panelScoutEl: HTMLElement | null = null;

  // ── Edit mode (?edit=1) ─────────────────────────────────────────────────
  // Pins become draggable so you can correct a spot whose photo-geolocation
  // landed it in the wrong place (the far side of a fence, etc.). Dropping a pin
  // PATCHes the live API, which persists it to the DB — no rebuild, shows for
  // everyone on the next load. Writes need the edit token (stored per-device).
  // Defined above initPanel so the panel's pencil toggle can gate on the token.
  // `editMode` is a live `let`, not a load-time const: the pencil flips it in
  // place (no reload, so map position/zoom are preserved) — long-press-move and
  // the promote button react to the current value rather than being wired once.
  let editMode = new URLSearchParams(location.search).get('edit') === '1';
  let editBtnEl: HTMLElement | null = null;
  const EDIT_MSG = '✎ Edit mode — press & hold a pin to move it, or open a pin to promote (leads) or delete it.';
  const TOKEN_KEY = 'forage.editToken';
  const getToken = () => { try { return localStorage.getItem(TOKEN_KEY) || ''; } catch { return ''; } };
  const setToken = (t: string) => { try { localStorage.setItem(TOKEN_KEY, t); } catch {} };
  const clearToken = () => { try { localStorage.removeItem(TOKEN_KEY); } catch {} };
  function ensureToken(): string {
    let t = getToken();
    if (!t) {
      const entered = window.prompt('Enter your edit token to save pin moves:');
      if (entered) { t = entered.trim(); setToken(t); }
    }
    return t;
  }

  // Reflect the current editMode onto the DOM: a body class drives promote-button
  // visibility (popups are HTML, so CSS gates them reactively) and the pencil's
  // fill/label. Called on load and on every toggle.
  function applyEditState() {
    document.body.classList.toggle('map-editing', editMode);
    // Persistent edit-mode banner — its OWN element, deliberately NOT the transient
    // flash line: flash() messages (Saving…, Pin lifted, Locating…) and clearFlash()
    // on each geolocation fix would otherwise wipe it while still editing.
    let banner = document.getElementById('edit-banner');
    if (editMode && !banner) {
      banner = document.createElement('div');
      banner.id = 'edit-banner';
      banner.className = 'edit-banner';
      banner.textContent = EDIT_MSG;
      (mapEl?.parentElement || mapEl)?.appendChild(banner);
    }
    if (banner) banner.hidden = !editMode;
    if (editBtnEl) {
      const t = editMode ? 'Exit edit mode' : 'Edit mode — move pins, promote leads';
      editBtnEl.classList.toggle('active', editMode);
      editBtnEl.title = t;
      editBtnEl.setAttribute('aria-label', t);
      editBtnEl.setAttribute('aria-pressed', String(editMode));
    }
  }
  // Flip edit mode without reloading — keep ?edit in the URL in sync (replaceState,
  // so it's still shareable/bookmarkable) but leave the map view untouched.
  function setEditMode(on: boolean) {
    editMode = on;
    const u = new URL(location.href);
    if (on) u.searchParams.set('edit', '1'); else u.searchParams.delete('edit');
    history.replaceState(null, '', u);
    applyEditState();          // shows/hides the persistent edit banner
    if (!on) clearFlash();     // drop any leftover transient message on exit
  }

  function initPanel() {
    let open = loadPref('panel.open', false);
    // The pencil edit-toggle sits to the LEFT of the Layers pill on the same row,
    // but only once an edit token is stored (never shown to public visitors).
    // Clicking flips edit mode in place (setEditMode) — no reload, so the map view
    // is preserved.
    const canEdit = !!getToken();
    const editTitle = editMode ? 'Exit edit mode' : 'Edit mode — move pins, promote leads';
    const PanelCtl = L.Control.extend({
      onAdd: function () {
        const wrap = L.DomUtil.create('div', 'map-panel' + (open ? ' open' : ''));
        L.DomEvent.disableClickPropagation(wrap);
        L.DomEvent.disableScrollPropagation(wrap);
        wrap.innerHTML =
          `<div class="map-panel-bar">` +
            (canEdit
              ? `<button type="button" class="map-panel-edit${editMode ? ' active' : ''}" aria-pressed="${editMode}" title="${editTitle}" aria-label="${editTitle}">` +
                  `<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">` +
                    `<path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" d="M4 20l4.5-1L20 7.5 16.5 4 5 15.5 4 20zM14.5 6l3.5 3.5"/></svg>` +
                `</button>`
              : '') +
            `<button type="button" class="map-panel-toggle" aria-expanded="${open}" aria-label="Map layers & legend">` +
              `<svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">` +
                `<path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" d="M12 3l9 5-9 5-9-5 9-5zM3 12l9 5 9-5M3 16l9 5 9-5"/></svg>` +
              `<span>Layers</span></button>` +
          `</div>` +
          `<div class="map-panel-body"${open ? '' : ' hidden'}>` +
            `<div class="panel-sec" id="panel-legend" hidden></div>` +
            `<div class="panel-sec scout-ctl" id="panel-scout" hidden></div>` +
          `</div>`;
        const btn = wrap.querySelector('.map-panel-toggle') as HTMLElement;
        const body = wrap.querySelector('.map-panel-body') as HTMLElement;
        panelLegendEl = wrap.querySelector('#panel-legend');
        panelScoutEl = wrap.querySelector('#panel-scout');
        btn.addEventListener('click', () => {
          open = !open;
          savePref('panel.open', open);
          wrap.classList.toggle('open', open);
          body.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
        });
        editBtnEl = wrap.querySelector('.map-panel-edit') as HTMLElement | null;
        if (editBtnEl) editBtnEl.addEventListener('click', () => setEditMode(!editMode));
        return wrap;
      },
    });
    new PanelCtl({ position: 'bottomright' }).addTo(map);
  }
  if (isFullMap) initPanel();
  applyEditState(); // reflect the initial ?edit state onto body + pencil

  // Optional ?plant=<slug> filter: a plant page can deep-link here to show only
  // the spots that link back to it (properties.plant === slug) — both confirmed
  // pins AND scouting leads for that plant.
  const plantFilter = new URLSearchParams(location.search).get('plant');

  // The deep-linked banner reports confirmed + lead counts, computed once both
  // loadConfirmed() and loadLeads() settle inside initFullMap().
  let fbConfirmed = 0, fbLeads = 0, fbLabel = '';
  function renderFilterBanner() {
    const el = document.getElementById('map-filter');
    if (!el || !plantFilter) return;
    const parts = [`${fbConfirmed} confirmed spot${fbConfirmed === 1 ? '' : 's'}`];
    if (fbLeads) parts.push(`${fbLeads} scouting lead${fbLeads === 1 ? '' : 's'}`);
    el.innerHTML =
      `<span>Showing ${parts.join(' + ')} for <strong>${esc(fbLabel || plantFilter)}</strong>.</span>` +
      `<a href="/map">Show all spots →</a>`;
    el.hidden = false;
  }

  async function saveMove(id: number, marker: any, origin: any) {
    const token = ensureToken();
    if (!token) { marker.setLatLng(origin); flash('No token — move not saved.'); return; }
    const { lat, lng } = marker.getLatLng();
    flash('Saving…', true);
    try {
      const r = await fetch('/api/pins/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
        body: JSON.stringify({ lon: +lng.toFixed(6), lat: +lat.toFixed(6) }),
      });
      if (r.status === 401) { clearToken(); marker.setLatLng(origin); flash('Edit token rejected — moved back. Drag again to re-enter it.', true); return; }
      if (!r.ok) { const e = await r.json().catch(() => ({})); throw new Error(e.error || ('HTTP ' + r.status)); }
      flash('Saved ✓');
    } catch (err: any) {
      marker.setLatLng(origin);
      flash('Save failed (' + (err?.message || err) + ') — moved back.');
    }
  }

  // Long-press to move (mobile-safe). Pins are inert to touch by default so you
  // can pan the map freely; press-and-hold ~0.45s on a pin to "lift" it, then drag
  // and release to drop. Moving the finger before the hold completes is treated as
  // a pan and never grabs the pin — which was the old draggable-marker footgun.
  function enableLongPressMove(marker: any, id: number) {
    const ARM_MS = 450, SLOP = 10;
    let timer: any = null, armed = false, start: any = null, originLL: any = null;

    const arm = () => {
      armed = true;
      originLL = marker.getLatLng();
      map.dragging.disable();               // don't pan while a pin is lifted
      marker.getElement()?.classList.add('pin-armed');
      try { (navigator as any).vibrate?.(30); } catch {}
      flash('Pin lifted — drag to move, release to drop.', true);
    };
    const disarm = () => {
      map.dragging.enable();
      marker.getElement()?.classList.remove('pin-armed');
    };
    const onMove = (e: any) => {
      if (!armed) {
        // A move before the hold completes = a pan/tap; abandon arming.
        if (start && Math.hypot(e.clientX - start.x, e.clientY - start.y) > SLOP) { clearTimeout(timer); cleanup(); }
        return;
      }
      e.preventDefault();
      marker.setLatLng(map.mouseEventToLatLng(e));
    };
    const onUp = (e: any) => {
      clearTimeout(timer);
      if (armed) {
        e.preventDefault?.();
        disarm();
        suppressNextClick(marker.getElement()); // don't pop the popup right after a move
        saveMove(id, marker, originLL);
      }
      cleanup();
    };
    const onCancel = () => {
      clearTimeout(timer);
      if (armed) { marker.setLatLng(originLL); disarm(); }
      cleanup();
    };
    const cleanup = () => {
      armed = false; start = null;
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      window.removeEventListener('pointercancel', onCancel);
    };
    const onDown = (e: any) => {
      if (!editMode) return; // handler is always attached; only arms while editing
      if (e.button != null && e.button > 0) return; // primary button / touch only
      start = { x: e.clientX, y: e.clientY };
      timer = setTimeout(arm, ARM_MS);
      window.addEventListener('pointermove', onMove, { passive: false });
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', onCancel);
    };
    marker.on('add', () => marker.getElement()?.addEventListener('pointerdown', onDown));
  }

  function suppressNextClick(el: any) {
    if (!el) return;
    const h = (ev: any) => { ev.stopPropagation(); ev.preventDefault(); el.removeEventListener('click', h, true); };
    el.addEventListener('click', h, true);
    setTimeout(() => el.removeEventListener('click', h, true), 500);
  }

  // Confirmed spots load live from the API; fall back to the build-time static
  // export if the service is down, so the map still renders. Leads are a static
  // export of the same DB (verified=0), so both share one feature shape.
  async function loadConfirmed() {
    try {
      const r = await fetch('/api/pins', { cache: 'no-store' });
      if (r.ok) return await r.json();
    } catch {}
    const r = await fetch('/data/foraging-spots.geojson?t=' + Date.now(), { cache: 'no-store' });
    return r.json();
  }
  async function loadLeads() {
    try {
      const r = await fetch('/data/pins-leads.geojson?t=' + Date.now(), { cache: 'no-store' });
      if (r.ok) return await r.json();
    } catch {}
    return { features: [] };
  }

  const isMapPage = document.querySelector('.map-wrap')?.classList.contains('full');

  // Home embed: confirmed spots only, plain teardrops + an inline legend. No panel,
  // no leads, no clustering — it's a small preview, not the working map.
  function initEmbed() {
    loadConfirmed().then((geo) => {
      const cats = new Set<string>();
      const markers: any[] = [];
      for (const f of geo.features || []) {
        const p = f.properties || {};
        if (plantFilter && p.plant !== plantFilter) continue;
        const cat = p.category || 'other';
        cats.add(cat);
        const [lon, lat] = f.geometry.coordinates;
        const m = L.marker([lat, lon], { icon: pinIcon(CAT_COLORS[cat] || CAT_COLORS.other, p.caution) }).addTo(map);
        m.bindPopup(pinPopup(p, String(f.id), true), { maxWidth: 244, minWidth: 200, maxHeight: 300, autoPan: true, keepInView: true });
        markers.push(m);
      }
      try {
        const b = L.featureGroup(markers).getBounds();
        if (b.isValid()) { spotsBounds = b; if (!didLocate) map.fitBounds(b.pad(0.35)); }
      } catch {}
      setTimeout(() => map.invalidateSize(), 60);
      const legend = document.getElementById('legend');
      if (legend) legend.innerHTML = [...cats].sort((a, b) => CAT_ORDER.indexOf(a) - CAT_ORDER.indexOf(b))
        .map((c) => `<span><i class="dot" style="background:${CAT_COLORS[c] || CAT_COLORS.other}"></i>${esc(CAT_LABEL[c] || c)}</span>`).join('');
    }).catch((err) => {
      if (mapEl) mapEl.innerHTML = '<p style="padding:20px">Could not load map data.</p>';
      console.error(err);
    });
  }

  if (isMapPage) initFullMap(); else initEmbed();

  function loadPref(key: string, fallback: boolean) {
    try { const v = localStorage.getItem(key); return v === null ? fallback : v === '1'; }
    catch { return fallback; }
  }
  function savePref(key: string, on: boolean) {
    try { localStorage.setItem(key, on ? '1' : '0'); } catch {}
  }

  // One popup for every pin. `verified` confirmed spots show season/location/photos;
  // leads show their source + a link back to it. Both carry an edit-mode Delete
  // button, and leads a Promote button (CSS gates those on body.map-editing).
  // Category badge + a caution line are shown for both.
  function pinPopup(p: any, key: string, verified: boolean) {
    const cat = p.category || 'other';
    const src = p.source || (verified ? 'confirmed' : 'inat');
    const photos: string[] = verified && Array.isArray(p.photos) ? p.photos : [];
    const imgs = photos
      .map((f) => `<a href="/photos/spots/${seg(f)}" target="_blank" rel="noopener"><img src="/photos/spots/${seg(f)}" alt="${esc(p.name)}" loading="lazy" /></a>`)
      .join('');
    let prov = '';
    if (!verified) {
      if (src === 'fallingfruit') prov = '◆ Falling Fruit · community spot';
      else if (src === 'montreal') {
        const extra = [p.where && esc(p.where), p.planted && ('planted ' + esc(p.planted))].filter(Boolean).join(' · ');
        prov = '▲ Ville de Montréal · city tree' + (extra ? ' · ' + extra : '');
      } else prov = `🔍 iNaturalist${p.observed ? ' · ' + esc(p.observed) : ''}${p.observer ? ' · @' + esc(p.observer) : ''}${p.obscured ? ' · ⚠ location obscured' : ''}`;
    }
    const linkLabel = src === 'fallingfruit' ? 'View on Falling Fruit →' : src === 'montreal' ? 'City tree dataset →' : 'View on iNaturalist →';
    return (
      `<div class="p-pop">` +
        `<h3>${esc(p.name) || (verified ? 'Spot' : 'Lead')}</h3>` +
        (p.species ? `<div class="p-sci">${esc(p.species)}</div>` : '') +
        `<div class="p-cat"><i class="dot" style="background:${CAT_COLORS[cat] || CAT_COLORS.other}"></i>${esc(CAT_LABEL[cat] || cat)}</div>` +
        (p.caution ? `<div class="p-caution">⚠ Caution — has a dangerous lookalike; be certain before you eat.</div>` : '') +
        (p.notes ? `<div class="p-meta">${esc(p.notes)}</div>` : '') +
        (verified && p.season ? `<div class="p-meta">🗓 ${esc(p.season)}</div>` : '') +
        (verified && p.location ? `<div class="p-meta">📍 ${esc(p.location)}</div>` : '') +
        (prov ? `<div class="p-meta p-obs">${prov}</div>` : '') +
        imgs +
        (!verified && /^https?:\/\//i.test(p.sourceUrl || '') ? `<a class="p-guide" href="${esc(p.sourceUrl)}" target="_blank" rel="noopener">${linkLabel}</a>` : '') +
        (p.plant ? `<a class="p-guide" href="/plants/${seg(p.plant)}">View plant guide →</a>` : '') +
        (!verified ? `<button type="button" class="scout-promote" data-promote="${esc(key)}">➕ Promote to confirmed spot</button>` : '') +
        `<button type="button" class="scout-delete" data-delete="${esc(key)}">🗑 Delete this pin</button>` +
      `</div>`
    );
  }

  // Fullscreen working map: confirmed spots AND scouting leads flow through ONE
  // marker-cluster group. Colour = category, shape = provenance (teardrop confirmed
  // / circle iNat / diamond FF / triangle city), amber ring = caution. The panel
  // toggles each layer + filters by type; a promoted lead flips to a confirmed pin.
  function initFullMap() {
    const SOURCES: Record<string, any> = {
      inat: { label: 'iNaturalist', glyph: '●', tag: 'research-grade · unverified', attrib: '' },
      fallingfruit: { label: 'Falling Fruit', glyph: '◆', tag: 'community · CC BY-NC-SA',
        attrib: 'Community spots via <a href="https://fallingfruit.org" target="_blank" rel="noopener">Falling Fruit</a> (CC BY-NC-SA)' },
      montreal: { label: 'City trees', glyph: '▲', tag: 'city inventory · sample',
        attrib: 'Public-tree inventory © <a href="https://donnees.montreal.ca/dataset/arbres" target="_blank" rel="noopener">Ville de Montréal</a> (CC BY 4.0)' },
    };
    const SOURCE_ORDER = ['inat', 'fallingfruit', 'montreal'];

    const cluster = (L as any).markerClusterGroup({
      maxClusterRadius: 55,
      showCoverageOnHover: false,
      spiderfyOnMaxZoom: true,
      chunkedLoading: true,
      iconCreateFunction: (c: any) => {
        const n = c.getChildCount();
        const size = n < 10 ? 34 : n < 100 ? 40 : 48;
        return L.divIcon({ html: `<span>${n}</span>`, className: 'scout-cluster', iconSize: [size, size] });
      },
    });
    cluster.addTo(map);

    type Rec = { id: any; key: string; masterKey: string; verified: boolean; source: string;
      category: string; caution: boolean; marker: any; props: any; lat: number; lon: number };
    const records: Rec[] = [];
    const inCluster = new Set<string>();
    const presentSrc = new Set<string>();
    let hasConfirmed = false;

    const build = (geo: any, verified: boolean) => {
      for (const f of geo.features || []) {
        const p = f.properties || {};
        if (plantFilter && p.plant !== plantFilter) continue;
        const source = p.source || (verified ? 'confirmed' : 'inat');
        const category = p.category || 'other';
        const caution = !!p.caution;
        const [lon, lat] = f.geometry.coordinates;
        const key = String(f.id);
        const masterKey = verified ? 'confirmed' : source;
        const icon = verified
          ? pinIcon(CAT_COLORS[category] || CAT_COLORS.other, caution)
          : leadIcon(SOURCE_SHAPE[source] || 'circle', CAT_COLORS[category] || CAT_COLORS.other, caution);
        const marker = L.marker([lat, lon], { icon })
          .bindPopup(pinPopup(p, key, verified), { maxWidth: 244, minWidth: 200, maxHeight: 300, autoPan: true, keepInView: true });
        if (verified && typeof f.id === 'number') enableLongPressMove(marker, f.id as number);
        records.push({ id: f.id, key, masterKey, verified, source, category, caution, marker, props: p, lat, lon });
        if (verified) hasConfirmed = true; else presentSrc.add(source);
      }
    };

    Promise.all([loadConfirmed(), loadLeads()]).then(([confirmed, leads]) => {
      // The persistent #edit-banner (applyEditState) shows the edit hint; no flash here.
      build(confirmed, true);
      build(leads, false);

      // Deep-link banner (confirmed + lead counts for one plant).
      if (plantFilter) {
        fbConfirmed = records.filter((r) => r.verified).length;
        fbLeads = records.filter((r) => !r.verified).length;
        const any = records.find((r) => r.props.species || r.props.name);
        if (any) fbLabel = any.props.species || any.props.name || '';
        renderFilterBanner();
      }

      // Fit to the confirmed spots (or everything under a plant filter) on first load.
      try {
        const forBounds = records.filter((r) => plantFilter || r.verified).map((r) => [r.lat, r.lon]);
        if (forBounds.length) { spotsBounds = L.latLngBounds(forBounds as any); if (!didLocate) map.fitBounds(spotsBounds.pad(0.35)); }
      } catch {}
      setTimeout(() => map.invalidateSize(), 60);

      const div = panelScoutEl;
      if (!div) return;
      div.hidden = false;

      // Layer visibility (persisted). My spots default ON; leads default OFF; a
      // ?plant deep-link forces everything on so the guide's leads surface.
      const state = {
        master: {} as Record<string, boolean>,
        cat: {} as Record<string, boolean>,
        caution: true,
      };
      state.master.confirmed = plantFilter ? true : loadPref('layer.confirmed', true);
      for (const s of SOURCE_ORDER) state.master[s] = plantFilter ? true : loadPref('scout.on.' + s, false);
      for (const c of CAT_ORDER) state.cat[c] = loadPref('filter.cat.' + c, true);
      state.caution = loadPref('filter.caution', true);

      const visible = (r: Rec) =>
        state.master[r.masterKey] && state.cat[r.category] && (state.caution || !r.caution);

      const apply = () => {
        const add: any[] = [], remove: any[] = [];
        for (const r of records) {
          const show = visible(r);
          if (show && !inCluster.has(r.key)) { add.push(r.marker); inCluster.add(r.key); }
          else if (!show && inCluster.has(r.key)) { remove.push(r.marker); inCluster.delete(r.key); }
        }
        if (remove.length) cluster.removeLayers(remove);
        if (add.length) cluster.addLayers(add);
      };
      apply();

      let renderCtl = () => {};

      // Delete a pin (edit mode). Confirmed spots are removed outright; leads are
      // tombstoned server-side so a re-scout won't resurrect them. Either way the
      // marker + record are dropped in place, no reload.
      const deletePinAt = async (key: string, btn: HTMLButtonElement) => {
        const i = records.findIndex((x) => x.key === key);
        if (i < 0) return;
        const r = records[i];
        if (!window.confirm(`Delete "${r.props.name || (r.verified ? 'this spot' : 'this lead')}"? This can't be undone.`)) return;
        const token = ensureToken();
        if (!token) { flash('No token — pin not deleted.'); return; }
        btn.disabled = true; btn.textContent = 'Deleting…';
        try {
          const resp = await fetch('/api/pins/' + r.id, {
            method: 'DELETE',
            headers: { Authorization: 'Bearer ' + token },
          });
          if (resp.status === 401) { clearToken(); flash('Edit token rejected — try again to re-enter it.', true); btn.disabled = false; btn.textContent = '🗑 Delete this pin'; return; }
          if (!resp.ok) { const e = await resp.json().catch(() => ({})); throw new Error(e.error || ('HTTP ' + resp.status)); }
          map.closePopup();
          if (inCluster.has(r.key)) { cluster.removeLayer(r.marker); inCluster.delete(r.key); }
          records.splice(i, 1);
          renderCtl();
          flash('Deleted ✓');
        } catch (err: any) {
          flash('Delete failed (' + (err?.message || err) + ').');
          btn.disabled = false; btn.textContent = '🗑 Delete this pin';
        }
      };

      // Promote a lead → a confirmed spot in ONE click: a lead already carries a
      // curated category, so there's nothing to pick. Tapping ➕ POSTs straight to
      // /api/pins/:id/promote (flips verified=1, keeps provenance so a re-scout
      // won't resurrect it) and we swap the marker to a teardrop in place.
      const promoteLead = async (key: string, btn: HTMLButtonElement) => {
        const r = records.find((x) => x.key === key);
        if (!r) return;
        const token = ensureToken();
        if (!token) { flash('No token — spot not created.'); return; }
        btn.disabled = true; btn.textContent = 'Promoting…';
        const reset = () => { btn.disabled = false; btn.textContent = '➕ Promote to confirmed spot'; };
        try {
          const resp = await fetch('/api/pins/' + r.id + '/promote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ category: r.category, plant: r.props.plant ?? null }),
          });
          if (resp.status === 401) { clearToken(); flash('Edit token rejected — try again to re-enter it.', true); reset(); return; }
          if (!resp.ok) { const e = await resp.json().catch(() => ({})); throw new Error(e.error || ('HTTP ' + resp.status)); }
          const { spot } = await resp.json();
          map.closePopup();
          // Convert the record in place: same marker slot, now a confirmed teardrop.
          if (inCluster.has(r.key)) { cluster.removeLayer(r.marker); inCluster.delete(r.key); }
          r.verified = true; r.masterKey = 'confirmed';
          r.props = { ...r.props, ...spot, verified: true };
          r.marker = L.marker([r.lat, r.lon], { icon: pinIcon(CAT_COLORS[r.category] || CAT_COLORS.other, r.caution) })
            .bindPopup(pinPopup(r.props, r.key, true), { maxWidth: 244, minWidth: 200, maxHeight: 300, autoPan: true, keepInView: true });
          if (typeof r.id === 'number') enableLongPressMove(r.marker, r.id);
          hasConfirmed = true;
          apply();
          renderCtl();
          flash('Promoted ✓ — now a confirmed spot.');
        } catch (err: any) {
          flash('Promote failed (' + (err?.message || err) + ').');
          reset();
        }
      };

      map.on('popupopen', (e: any) => {
        const el = e.popup.getElement();
        if (!el) return;
        L.DomEvent.disableClickPropagation(el);
        const db = el.querySelector('.scout-delete') as HTMLButtonElement | null;
        if (db) db.addEventListener('click', () => deletePinAt(String(db.dataset.delete), db), { once: true });
        const pb = el.querySelector('.scout-promote') as HTMLButtonElement | null;
        if (pb) pb.addEventListener('click', () => promoteLead(String(pb.dataset.promote), pb), { once: true });
      });

      const layerCount = (mk: string) => records.filter((r) => r.masterKey === mk).length;
      const catCount = (c: string) => records.filter((r) => r.category === c && (state.caution || !r.caution)).length;
      const cautionCount = () => records.filter((r) => r.caution).length;
      const catsShown = CAT_ORDER.filter((c) => records.some((r) => r.category === c));
      const srcShown = SOURCE_ORDER.filter((s) => presentSrc.has(s));

      renderCtl = () => {
        const layerRow = (mk: string, glyph: string, label: string, tag: string, on: boolean) =>
          `<label class="scout-master"><input type="checkbox" data-master="${mk}"${on ? ' checked' : ''}>` +
          `<span class="scout-src"><b>${glyph} ${label}</b><em>${tag} · ${layerCount(mk)}</em></span></label>`;
        div.innerHTML =
          `<h4 class="panel-h">Map pins <em>colour = type · ⚠ = lookalike</em></h4>` +
          (hasConfirmed ? layerRow('confirmed', '📍', 'My spots', 'confirmed', state.master.confirmed) : '') +
          srcShown.map((s) => layerRow(s, SOURCES[s].glyph, SOURCES[s].label, SOURCES[s].tag, state.master[s])).join('') +
          `<div class="scout-tiers">` +
            `<div class="scout-tiers-h">Filter by type</div>` +
            catsShown.map((c) =>
              `<label class="scout-tier"><input type="checkbox" data-cat="${c}"${state.cat[c] ? ' checked' : ''}>` +
              `<i class="dot" style="background:${CAT_COLORS[c]}"></i>${CAT_LABEL[c]} <b>${catCount(c)}</b></label>`).join('') +
            (cautionCount() ? `<label class="scout-tier scout-caution"><input type="checkbox" data-caution${state.caution ? ' checked' : ''}>` +
              `<i class="dot" style="background:${CAUTION_COLOR}"></i>⚠ Caution — lookalikes <b>${cautionCount()}</b></label>` : '') +
          `</div>` +
          srcShown.filter((s) => SOURCES[s].attrib).map((s) => `<p class="scout-attrib">${SOURCES[s].attrib}</p>`).join('');
        div.querySelectorAll('input[data-master]').forEach((el) => el.addEventListener('change', () => {
          const k = (el as HTMLInputElement).dataset.master as string;
          state.master[k] = (el as HTMLInputElement).checked;
          savePref(k === 'confirmed' ? 'layer.confirmed' : 'scout.on.' + k, state.master[k]);
          apply();
        }));
        div.querySelectorAll('input[data-cat]').forEach((el) => el.addEventListener('change', () => {
          const c = (el as HTMLInputElement).dataset.cat as string;
          state.cat[c] = (el as HTMLInputElement).checked;
          savePref('filter.cat.' + c, state.cat[c]);
          apply();
        }));
        const cb = div.querySelector('input[data-caution]');
        if (cb) cb.addEventListener('change', () => {
          state.caution = (cb as HTMLInputElement).checked;
          savePref('filter.caution', state.caution);
          apply(); renderCtl();
        });
      };
      renderCtl();
    }).catch((err) => {
      if (mapEl) mapEl.innerHTML = '<p style="padding:20px">Could not load map data.</p>';
      console.error(err);
    });
  }

  window.addEventListener('resize', () => map.invalidateSize());
  void isTouch;
</script>
