---
import Base from '../../layouts/Base.astro';
import { effectiveStatus, STATUS_LABEL } from '../../lib/season';
import { spotCount } from '../../lib/spots';
import { scoutCount } from '../../lib/scouting.mjs';
import { getPlants } from '../../lib/content.mjs';

export async function getStaticPaths() {
  return getPlants().map((p) => ({ params: { slug: p.id }, props: { plant: p } }));
}

const { plant } = Astro.props;
const d = plant.data;
const live = effectiveStatus(d);
const statusLabel = STATUS_LABEL;
// Derived at build time — a confirmed spot (SQLite) with `plant: <slug>` lights
// this up automatically, no manual `onMap` flag to keep in sync. Unverified
// scouting leads (the static GeoJSON sources) referencing this plant are counted
// too, so the badge shows the total on the map with confirmed broken out.
const spots = spotCount(plant.id);
const leads = scoutCount(plant.id);
const onMap = spots + leads;
---
<Base title={`${d.title} — Forage MTL`} page="plants" description={d.scientificName ? `${d.title} (${d.scientificName}) — ID, safety, harvest & prep.` : d.title}>
  <article class="plant wrap">
    <a class="back" href="/plants">← All plants</a>
    <h1>{d.title}</h1>
    {d.scientificName && <p class="sci">{d.scientificName}{d.commonNames.length ? ` · also: ${d.commonNames.join(', ')}` : ''}</p>}
    <p style="margin:-6px 0 20px;">
      <span class={`badge ${live}`}>{statusLabel[live]}</span>
      {d.season && <span style="color:var(--ink-soft); margin-left:10px;">🗓 {d.season}</span>}
      {onMap > 0 && <a href={`/map?plant=${plant.id}`} style="margin-left:10px;">📍 {onMap} on map{leads > 0 && ` (${spots} confirmed)`}</a>}
    </p>

    {d.heroImage && <img class="hero-img" src={d.heroImage} alt={d.title} loading="eager" />}

    {d.idCues.length > 0 && (
      <div class="panel">
        <h2>How to ID it</h2>
        <ul>{d.idCues.map((c) => <li set:html={c} />)}</ul>
      </div>
    )}

    {d.safety.length > 0 && (
      <div class="panel safety">
        <h2>⚠ Safety &amp; lookalikes</h2>
        <ul>{d.safety.map((s) => <li set:html={s} />)}</ul>
      </div>
    )}

    <div class="prose" set:html={plant.bodyHtml} />


    {d.gallery.length > 0 && (
      <div class="gallery">
        {d.gallery.map((g) => (
          <figure>
            <a href={g.src} target="_blank" rel="noopener"><img src={g.src} alt={g.caption || d.title} loading="lazy" /></a>
            {(g.caption || g.credit) && <figcaption>{g.caption}{g.credit ? ` — ${g.credit}` : ''}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    {d.guides.length > 0 && (
      <div class="panel">
        <h2>Guides &amp; links</h2>
        <ul class="guides">
          {d.guides.map((g) => <li><a href={g.url} target="_blank" rel="noopener">{g.label} ↗</a></li>)}
        </ul>
      </div>
    )}

    {d.updated && <p style="color:var(--ink-soft); font-size:.82rem;">Updated {d.updated}</p>}
  </article>
</Base>
