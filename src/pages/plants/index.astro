---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { effectiveStatus, STATUS_LABEL } from '../../lib/season';
import { spotCount } from '../../lib/spots';

const order = { 'ripe-now': 0, 'coming-soon': 1, 'year-round': 2, 'note-for-next-year': 3 };
const plants = (await getCollection('plants'))
  .map((p) => ({ ...p, live: effectiveStatus(p.data), spots: spotCount(p.id) }))
  .sort((a, b) => order[a.live] - order[b.live] || a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
---
<Base title="Plants — Forage MTL" page="plants" description="Field guide to urban edible plants around Montréal.">
  <section class="wrap section">
    <h1 style="margin:0 0 6px;">Plants to look for</h1>
    <p style="color:var(--ink-soft); margin:0 0 24px; max-width:62ch;">
      Urban foraging is mostly "weeds" and a few ornamental trees that happen to be edible — not orchards.
      Each page has ID cues, safety notes, and space for harvest &amp; prep notes.
    </p>
    <div class="grid">
      {plants.map((p) => (
        <a class="card" href={`/plants/${p.id}`}>
          <div class="thumb" style={p.data.heroImage ? `--ph:url('${p.data.heroImage}')` : ''}></div>
          <div class="body">
            <span class="name">{p.data.title}</span>
            {p.data.scientificName && <span class="sci">{p.data.scientificName}</span>}
            <span class="meta">
              <span class={`badge ${p.live}`}>{STATUS_LABEL[p.live]}</span>
              {p.spots > 0 && <span class="on-map">📍 on map</span>}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
