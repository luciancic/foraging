---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const plants = (await getCollection('plants')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const statusLabel: Record<string, string> = {
  'ripe-now': 'ripe now',
  'coming-soon': 'coming soon',
  'note-for-next-year': 'next year',
  'year-round': 'year-round',
};
---
<Base title="Plants — Forage MTL" page="plants" description="Field guide to urban edible plants around Montréal.">
  <section class="wrap" style="padding: 30px 0 12px;">
    <h1 style="margin:0 0 6px;">Plants to look for</h1>
    <p style="color:var(--ink-soft); margin:0 0 24px; max-width:62ch;">
      Urban foraging is mostly "weeds" and a few ornamental trees that happen to be edible — not orchards.
      Each page has ID cues, safety notes, and space for harvest &amp; prep notes.
    </p>
    <div class="grid">
      {plants.map((p) => (
        <a class="card" href={`/plants/${p.slug}`}>
          <div class="thumb" style={p.data.heroImage ? `--ph:url('${p.data.heroImage}')` : ''}></div>
          <div class="body">
            <span class="name">{p.data.title}</span>
            {p.data.scientificName && <span class="sci">{p.data.scientificName}</span>}
            <span class="meta">
              <span class={`badge ${p.data.status}`}>{statusLabel[p.data.status]}</span>
              {p.data.onMap && <span style="margin-left:8px">📍 on map</span>}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
