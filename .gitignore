node_modules/
dist/
.astro/
# Live SQLite database — runtime source of truth, not committed.
# db/seed.json is the committed snapshot; restore/rebuild from it.
# Anchored to repo root so it does NOT also swallow public/data/ (the committed
# map GeoJSONs live there).
/data/
# Photos live in Storj (bucket prefix media/), served by the API — not committed.
# media-cache/ is the API's local read-through cache of them.
public/photos/
public/images/
media-cache/
.env
.DS_Store
npm-debug.log*
